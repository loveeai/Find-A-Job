D,EAAKC,IAAL,EAAWC,IAAX,EAAmB;AACnC;AACA;AACA;AAEA,MAAGF,EAAE,CAACT,IAAH,IAAW,QAAX,IAAuBS,EAAE,CAACT,IAAH,IAAW,MAAlC,IAA4CS,EAAE,CAACT,IAAH,IAAW,WAA1D,EAAuE,OAAOW,IAAI,EAAX,CALpC,CAOnC;;AACA9B,EAAAA,SAAS,CAAC+B,KAAV,GARmC,CASnC;;AACA,MAAMC,KAAK,GAAGC,MAAM,CAACC,cAAP,CAAsBC,OAAtB,CAA8B,OAA9B,CAAd;;AACA,MAAG,CAACH,KAAJ,EAAU;AACRjC,IAAAA,OAAO,CAACqC,KAAR,CAAc,SAAd;AACA,WAAON,IAAI,CAAC,QAAD,CAAX;AACD;;AACDA,EAAAA,IAAI;AACL,CAhBD;AAkBAL,MAAM,CAACY,SAAP,CAAiB,YAAM;AACrBrC,EAAAA,SAAS,CAACsC,IAAV;AACD,CAFD;AAIA,IAAMC,YAAY,GAAG1C,SAAS,CAAC2C,SAAV,CAAoBC,IAAzC;;AACA5C,SAAS,CAAC2C,SAAV,CAAoBC,IAApB,GAA2B,SAASA,IAAT,CAAcC,QAAd,EAAuB;AAChD,SAAOH,YAAY,CAACI,IAAb,CAAkB,IAAlB,EAAwBD,QAAxB,EAAkCE,KAAlC,CAAwC,UAAAC,GAAG;AAAA,WAAIA,GAAJ;AAAA,GAA3C,CAAP;AACD,CAFD;;AAKA,eAAepB,MAAf","sourcesContent":["import Vue from 'vue'\r\nimport VueRouter from 'vue-router'\r\nimport Home from '../views/Home.vue'\r\nimport { Message }from 'element-ui'\r\nimport NProgress from 'nprogress'\r\nimport 'nprogress/nprogress.css'\r\nimport Login from '@/views/Login';\r\nimport Welcome from \"@/views/Welcome\";\r\nimport Register from \"../views/Register\";\r\nimport Job from \"../views/vaccine/Job\";\r\nimport Interview from \"../views/vaccine/Interview\";\r\nimport Company from \"../views/vaccine/Company\";\r\nimport Carousel from \"../views/vaccine/Carousel\";\r\nimport Toudi from \"../views/vaccine/Toudi\";\r\nimport Category from \"../views/vaccine/Category\";\r\nimport Statistics from \"../views/vaccine/Statistics\";\r\nimport UserInfo from \"@/views/user/UserInfo\";\r\nimport UserInfo2 from \"@/views/user/UserInfo2\";\r\nimport Userm from \"@/views/user/Userm\";\r\nimport ResourceInfo from \"@/views/role/ResourceInfo\";\r\nimport RoleInfo from \"@/views/role/RoleInfo\";\r\nimport Error404 from \"@/views/Error404\";\r\n\r\nVue.use(VueRouter)\r\n\r\nconst routes = [\r\n\r\n  {\r\n    path: '/',\r\n    component: Login,\r\n    redirect: '/login'\r\n  },\r\n  {\r\n    path: '/login',\r\n    component: Login\r\n  },\r\n  {\r\n    path: '/home',\r\n    component: Home,\r\n    redirect: '/welcome',\r\n    children: [\r\n      { path: '/welcome', component: Welcome },\r\n      { path: '/job', component: Job, meta: { btnPermission: 'admin' }},\r\n      { path: '/category', component: Category, meta: { btnPermission: 'admin' }},\r\n      { path: '/toudi', component: Toudi, meta: { btnPermission: 'admin' }},\r\n      { path: '/company', component: Company, meta: { btnPermission: 'admin' }},\r\n      { path: '/carousel', component: Carousel, meta: { btnPermission: 'admin' }},\r\n      { path: '/interview', component: Interview, meta: { btnPermission: 'admin' }},\r\n      { path: '/statistics', component: Statistics, meta: { btnPermission: 'admin' }},\r\n      { path: '/user', component: UserInfo, meta: { btnPermission: 'admin' }},\r\n      { path: '/user2', component: UserInfo2, meta: { btnPermission: 'admin' }},\r\n      { path: '/userm', component: Userm, meta: { btnPermission: 'admin' }},\r\n      { path: '/role', component: RoleInfo, meta: { btnPermission: 'admin' }},\r\n      { path: '/resource', component: ResourceInfo, meta: { btnPermission: 'admin' }},\r\n    ]\r\n  },\r\n  {\r\n    path: '/register',\r\n    component: Register\r\n  },\r\n  \r\n  {\r\n    path: '/*',\r\n    component: Error404\r\n  }\r\n]\r\n\r\nconst router = new VueRouter({\r\n  routes,\r\n  mode: 'history',\r\n})\r\n\r\n//挂载路由导航守卫\r\nrouter.beforeEach((to, from, next) =>{\r\n  //to 将要访问的路径\r\n  //from 从哪个页面来\r\n  //next 一个放行函数\r\n\r\n  if(to.path == '/login' || to.path == '/404' || to.path == '/register') return next();\r\n\r\n  //顶部进度条\r\n  NProgress.start()\r\n  //获取token\r\n  const token = window.sessionStorage.getItem(\"token\")\r\n  if(!token){\r\n    Message.error('抱歉，请先登录')\r\n    return next('/login');\r\n  }\r\n  next();\r\n})\r\n\r\nrouter.afterEach(() => {\r\n  NProgress.done()\r\n})\r\n\r\nconst originalPush = VueRouter.prototype.push\r\nVueRouter.prototype.push = function push(location){\r\n  return originalPush.call(this, location).catch(err => err)\r\n}\r\n\r\n\r\nexport default router\r\n"]}]}