{"remainingRequest":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\babel-loader\\lib\\index.js!D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\bishe\\springboot+vue\\job\\study\\ui\\src\\views\\Home.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\src\\views\\Home.vue","mtime":1745005886962},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Home.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAkDA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,SAAA,EAAA,EADA;AAEA;AACA,MAAA,QAAA,EAAA,EAHA;AAIA,MAAA,QAAA,EAAA;AACA,aAAA,iBADA;AAEA,aAAA,iBAFA;AAGA,aAAA,iBAHA;AAIA,aAAA,iBAJA;AAKA,aAAA,kBALA;AAMA,aAAA;AANA,OAJA;AAYA,MAAA,WAAA,EAAA;AAZA,KAAA;AAcA,GAhBA;AAiBA,EAAA,IAAA,EAAA,MAjBA;AAkBA,EAAA,OAlBA,qBAkBA;AACA,SAAA,WAAA;AACA,GApBA;AAqBA,EAAA,OAAA,EAAA;AACA,IAAA,MADA,oBACA;AACA;AACA,MAAA,MAAA,CAAA,cAAA,CAAA,KAAA;AACA,WAAA,OAAA,CAAA,IAAA,CAAA,QAAA;AACA,KALA;AAMA,IAAA,WANA,yBAMA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AACA,gBAAA,SADA,GACA,IAAA,CAAA,KAAA,CAAA,MAAA,CAAA,cAAA,CAAA,OAAA,CAAA,WAAA,CAAA,CADA;AAEA,gBAAA,KAAA,CAAA,SAAA,GAAA,IAAA,CAAA,KAAA,CAAA,MAAA,CAAA,cAAA,CAAA,OAAA,CAAA,WAAA,CAAA,EAAA,OAAA;AACA,gBAAA,OAAA,CAAA,GAAA,CAAA,SAAA;AACA,gBAAA,KAAA,CAAA,QAAA,GAAA,SAAA,CAAA,OAAA,CAAA,OAAA,CAAA,QAAA;AACA,gBAAA,OAAA,CAAA,GAAA,CAAA,KAAA,CAAA,QAAA;;AALA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAMA,KAZA;AAaA;AACA,IAAA,cAdA,4BAcA;AACA,WAAA,WAAA,GAAA,CAAA,KAAA,WAAA;AACA,KAhBA;AAiBA,IAAA,SAjBA,uBAiBA;AACA,WAAA,OAAA,CAAA,IAAA,CAAA,aAAA;AACA;AAnBA;AArBA,CAAA","sourcesContent":["<template>\r\n  <el-container class=\"home-container\">\r\n    <el-header>\r\n      \r\n      <div class=\"span-container\" style=\"padding: 5px\" @click=\"toWelcome\">\r\n        <el-avatar :src=\"'http://127.0.0.1:8182'+ JSON.parse(this.loginUser.userPicture)\" :size=\"50\" style=\"margin-right:10px\"></el-avatar>\r\n        <span style=\"font-size: 30px;font-weight: 600;\">毕业生就业推荐系统</span>\r\n      </div>\r\n      <el-button type=\"info\" @click=\"logout\">退出</el-button>\r\n    </el-header>\r\n    <el-container>\r\n      <el-aside :width=\"isCollapsed ? '64px' : '250px'\">\r\n        <!--侧边栏菜单-->\r\n        <el-menu\r\n            background-color=\"#8a93e9\"\r\n            text-color=\"#fff\"\r\n            active-text-color=\"#409EFF\"\r\n            unique-opened\r\n            :collapse=\"isCollapsed\"\r\n            :collapse-transition=\"false\"\r\n            :router=\"true\"\r\n            :default-active=\"$route.path\">\r\n          <!--一级菜单-->\r\n          <el-submenu :index=\"String(item.id)\" v-for=\"item in menulist\" :key=\"item.id\">\r\n            <template slot=\"title\">\r\n              <i :class=\"iconlist[item.id]\"></i>\r\n              <span style=\"font-weight: 600;\">{{item.name}}</span>\r\n            </template>\r\n            <!--二级菜单-->\r\n            <el-menu-item :index=\"'/' + subItem.path\" v-for=\"subItem in item.children\" :key=\"subItem.id\" >\r\n              <template slot=\"title\">\r\n                <!--图标-->\r\n                <i class=\"el-icon-menu\"></i>\r\n                <!--文本-->\r\n                <span style=\"font-weight: 600;\">{{ subItem.name }}</span>\r\n              </template>\r\n            </el-menu-item>\r\n          </el-submenu>\r\n        </el-menu>\r\n      </el-aside>\r\n      <el-main>\r\n        <router-view></router-view>\r\n      </el-main>\r\n    </el-container>\r\n  </el-container>\r\n</template>\r\n\r\n\r\n\r\n<script>\r\nexport default {\r\n  data(){\r\n    return {\r\n      loginUser:{},\r\n      //左侧菜单数据\r\n      menulist:[],\r\n      iconlist: {\r\n        '1': 'el-icon-setting',\r\n        '3': 'el-icon-setting',\r\n        '4': 'el-icon-setting',\r\n        '2': 'el-icon-setting',\r\n        '6': 'el-icon-s-custom',\r\n        '7': 'el-icon-info',\r\n      },\r\n      isCollapsed: false\r\n    }\r\n  },\r\n  name: \"Home\",\r\n  created(){\r\n    this.getMenuList()\r\n  },\r\n  methods:{\r\n    logout(){\r\n      //清空sessionStorage\r\n      window.sessionStorage.clear();\r\n      this.$router.push('/login')\r\n    },\r\n    async getMenuList(){\r\n      const loginUser = JSON.parse(window.sessionStorage.getItem(\"loginUser\"))\r\n      this.loginUser = JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser\r\n      console.log(loginUser)\r\n      this.menulist = loginUser.sysUser.sysRole.children\r\n      console.log(this.menulist)\r\n    },\r\n    // 菜单展开与闭合：点击事件\r\n    toggleCollapse(){\r\n      this.isCollapsed = !this.isCollapsed\r\n    },\r\n    toWelcome(){\r\n      this.$router.push('/statistics')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n.home-container{\r\n  background-color:#8a93e9 ;\r\n  height: 100%;\r\n}\r\n\r\n.el-header {\r\n  background-color: #8a93e9;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  padding-left: 0;\r\n  align-items: center;\r\n  color: whitesmoke;\r\n  font-size: 20px;\r\n}\r\n\r\n.el-header > div{\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\ndiv > span{\r\n  margin-left: 15px;\r\n}\r\n\r\n.el-aside {\r\n  background-color:  #8a93e9;\r\n}\r\n\r\n\r\n.toggle-button{\r\n  background-color:  #8a93e9;\r\n  font-size: 10px;\r\n  line-height: 24px;\r\n  color: #fff;\r\n  text-align: center;\r\n  letter-spacing: 0.1em;\r\n  cursor: pointer;\r\n}\r\n\r\n.span-container{\r\n  cursor: pointer;\r\n}\r\n\r\n.el-main{\r\n  /* background: url(\"../assets/91.png\"); */\r\n  background-color: #fff;\r\n  background-size: cover;\r\n  border-radius: 100px 100px 100px 100px;\r\n\r\n\r\n}\r\n\r\n.el-menu{\r\n  border: solid 0  #8a93e9\r\n}\r\n</style>\r\n"],"sourceRoot":"src/views"}]}