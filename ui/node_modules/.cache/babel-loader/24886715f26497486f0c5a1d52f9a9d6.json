A;AAAA;AAAA;;AAEA,kBAAA,KAAA,CAAA,OAAA,GAAA,KAAA;AAFA;;AAAA;AAAA;AAMA,kBAAA,KAAA,CAAA,QAAA,CAAA,OAAA,CAAA,IAAA,CAAA,cAAA,IAAA,kBAAA;AANA;AAAA,yBAOA,KAAA,CAAA,IAAA,CACA,eADA,EAEA,IAAA,CAAA,SAAA,CAAA,KAAA,CAAA,SAAA,CAFA,CAPA;;AAAA;AAAA;AAOA,kBAAA,GAPA,qBAOA,IAPA;;AAAA,wBAWA,GAAA,CAAA,IAAA,IAAA,GAXA;AAAA;AAAA;AAAA;;AAAA,mDAWA,KAAA,CAAA,QAAA,CAAA,KAAA,CAAA,GAAA,CAAA,GAAA,CAXA;;AAAA;AAYA,kBAAA,KAAA,CAAA,QAAA,CAAA,OAAA,CAAA,MAAA;;AACA,kBAAA,MAAA,CAAA,cAAA,CAAA,OAAA,CAAA,OAAA,EAAA,GAAA,CAAA,IAAA,CAAA,KAAA;AACA,kBAAA,MAAA,CAAA,cAAA,CAAA,OAAA,CACA,WADA,EAEA,IAAA,CAAA,SAAA,CAAA;AACA,oBAAA,OAAA,EAAA,GAAA,CAAA,IAAA,CAAA,OADA;AAEA,oBAAA,QAAA,EAAA,GAAA,CAAA,IAAA,CAAA,QAFA;AAGA,oBAAA,UAAA,EAAA,GAAA,CAAA,IAAA,CAAA;AAHA,mBAAA,CAFA;AAQA,kBAAA,MAAA,CAAA,cAAA,CAAA,OAAA,CACA,eADA,EAEA,GAAA,CAAA,IAAA,CAAA,OAAA,CAAA,MAAA,KAAA,CAAA,GAAA,OAAA,GAAA,QAFA,EAtBA,CA0BA;;AACA,kBAAA,KAAA,CAAA,OAAA,CAAA,IAAA,CAAA,UAAA;;AA3BA;AAAA;;AAAA;AAAA;AAAA;;AA6BA,kBAAA,KAAA,CAAA,QAAA,CAAA,KAAA,CAAA,cAAA;;AACA,kBAAA,KAAA,CAAA,OAAA,GAAA,KAAA;;AA9BA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,SAAA;;AAAA;AAAA;AAAA;AAAA;AAiCA;AAvCA;AA1BA,CAAA","sourcesContent":["<template>\r\n  <div class=\"login-wrap\">\r\n    <div class=\"login-content\">\r\n      <el-form label-position=\"left\" :model=\"loginForm\" :rules=\"loginFormRules\" ref=\"loginFormRef\" label-width=\"0px\"\r\n        class=\"login-container\">\r\n        <!-- 系统Logo和标题 -->\r\n        <div class=\"login-header\">\r\n          <div class=\"logo\">\r\n            <i class=\"el-icon-medical\"></i>\r\n          </div>\r\n          <h3 class=\"title\">大学生兼职小程序后台</h3>\r\n        </div>\r\n        \r\n        <!-- 登录表单 -->\r\n        <el-form-item prop=\"userName\">\r\n          <div class=\"input-wrapper\">\r\n            <i class=\"el-icon-user\"></i>\r\n            <el-input type=\"text\" v-model=\"loginForm.userName\" auto-complete=\"off\" placeholder=\"账号\"></el-input>\r\n          </div>\r\n        </el-form-item>\r\n        \r\n        <el-form-item prop=\"password\">\r\n          <div class=\"input-wrapper\">\r\n            <i class=\"el-icon-lock\"></i>\r\n            <el-input type=\"password\" v-model=\"loginForm.password\" auto-complete=\"off\" placeholder=\"密码\"></el-input>\r\n          </div>\r\n        </el-form-item>\r\n        \r\n        <el-form-item>\r\n          <el-button type=\"primary\" @click=\"login\" style=\"width:100%\">点击登录</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n      \r\n      <!-- 系统版权信息 -->\r\n      <div class=\"copyright\">\r\n        <p>© 2025 智能陪诊系统 版权所有</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Login\",\r\n  data() {\r\n    return {\r\n      //登录表单数据对象\r\n      loginForm: {\r\n        userName: \"admin\",\r\n        password: \"000000\"\r\n      },\r\n      //表单验证规则\r\n      loginFormRules: {\r\n        //验证用户名\r\n        userName: [\r\n          { required: true, message: \"请输入用户名称\", trigger: \"blur\" },\r\n          { min: 2, max: 20, message: \"长度在2到20个字符之间\", trigger: \"blur\" }\r\n        ],\r\n        //验证密码\r\n        password: [\r\n          { required: true, message: \"请输入密码\", trigger: \"blur\" },\r\n          { min: 6, max: 16, message: \"长度在6到16个字符之间\", trigger: \"blur\" }\r\n        ]\r\n      },\r\n      //加载状态\r\n      loading: false\r\n    };\r\n  },\r\n  methods: {\r\n    registerAccount() {\r\n      this.$router.push(\"/register\");\r\n    },\r\n    login() {\r\n      this.loading = true;\r\n      this.$refs.loginFormRef.validate(async valid => {\r\n        if (!valid) {\r\n          this.loading = false;\r\n          return;\r\n        }\r\n        try {\r\n          axios.defaults.headers.post[\"Content-Type\"] = \"application/json\";\r\n          const { data: res } = await axios.post(\r\n            \"sysUser/login\",\r\n            JSON.stringify(this.loginForm)\r\n          );\r\n          if (res.code != 200) return this.$message.error(res.msg);\r\n          this.$message.success(\"登录成功\");\r\n          window.sessionStorage.setItem(\"token\", res.data.token);\r\n          window.sessionStorage.setItem(\r\n            \"loginUser\",\r\n            JSON.stringify({\r\n              sysUser: res.data.sysUser,\r\n              cinemaId: res.data.cinemaId,\r\n              cinemaName: res.data.cinemaName\r\n            })\r\n          );\r\n          window.sessionStorage.setItem(\r\n            \"btnPermission\",\r\n            res.data.sysUser.roleId === 1 ? \"admin\" : \"normal\"\r\n          );\r\n          //导航跳转到首页\r\n          this.$router.push(\"/welcome\");\r\n        } catch (error) {\r\n          this.$message.error(\"登录失败，请检查网络连接\");\r\n          this.loading = false;\r\n        }\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 全局样式重置 */\r\n* {\r\n  margin: 0;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* 登录页面背景 */\r\n.login-wrap {\r\n  width: 100%;\r\n  height: 100vh;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n  background-size: cover;\r\n  background-position: center;\r\n  background-attachment: fixed;\r\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n  overflow: hidden;\r\n}\r\n\r\n/* 登录内容容器 */\r\n.login-content {\r\n  width: 100%;\r\n  max-width: 420px;\r\n  padding: 0 20px;\r\n  animation: fadeInUp 0.6s ease-out;\r\n}\r\n\r\n/* 登录表单容器 */\r\n.login-container {\r\n  background: rgba(255, 255, 255, 0.95);\r\n  padding: 40px 30px;\r\n  border-radius: 16px;\r\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);\r\n  backdrop-filter: blur(10px);\r\n  border: 1px solid rgba(255, 255, 255, 0.3);\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.login-container:hover {\r\n  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n/* 登录头部 */\r\n.login-header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n/* Logo */\r\n.logo {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin: 0 auto 20px;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n  border-radius: 50%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  font-size: 40px;\r\n  color: white;\r\n  box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);\r\n  animation: pulse 2s ease-in-out infinite;\r\n}\r\n\r\n/* 标题 */\r\n.title {\r\n  font-size: 24px;\r\n  font-weight: 700;\r\n  color: #333;\r\n  margin: 0;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n/* 输入框容器 */\r\n.input-wrapper {\r\n  position: relative;\r\n  margin-bottom: 20px;\r\n  border-radius: 8px;\r\n  background: #f5f7fa;\r\n  transition: all 0.3s ease;\r\n  overflow: hidden;\r\n}\r\n\r\n.input-wrapper:hover {\r\n  background: #e8ecf1;\r\n}\r\n\r\n.input-wrapper i {\r\n  position: absolute;\r\n  left: 15px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  color: #909399;\r\n  font-size: 18px;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n/* 登录按钮 */\r\n.login-btn {\r\n  width: 100%;\r\n  height: 50px;\r\n  border-radius: 8px;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n  border: none;\r\n  color: white;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  letter-spacing: 1px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.login-btn:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);\r\n}\r\n\r\n/* 系统版权信息 */\r\n.copyright {\r\n  text-align: center;\r\n  margin-top: 25px;\r\n  color: rgba(255, 255, 255, 0.8);\r\n  font-size: 14px;\r\n}\r\n\r\n.copyright p {\r\n  margin: 0;\r\n}\r\n\r\n/* 动画效果 */\r\n@keyframes fadeInUp {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(30px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n@keyframes pulse {\r\n  0%, 100% {\r\n    transform: scale(1);\r\n  }\r\n  50% {\r\n    transform: scale(1.05);\r\n  }\r\n}\r\n\r\n/* 响应式设计 */\r\n@media (max-width: 480px) {\r\n  .login-container {\r\n    padding: 30px 25px;\r\n  }\r\n  \r\n  .title {\r\n    font-size: 20px;\r\n  }\r\n  \r\n  .logo {\r\n    width: 60px;\r\n    height: 60px;\r\n    font-size: 30px;\r\n  }\r\n}\r\n</style>"],"sourceRoot":"src/views"}]}