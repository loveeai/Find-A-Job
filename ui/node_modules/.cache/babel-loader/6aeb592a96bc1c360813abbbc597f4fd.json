SAXA;AAeA,QAAA,KAAA,EAAA;AACA,UAAA,IAAA,EAAA;AADA,SAfA;AAkBA,QAAA,MAAA,EAAA,CACA;AACA,UAAA,IAAA,EAAA,KADA;AAEA,UAAA,IAAA,EAAA,MAFA;AAGA,UAAA,MAAA,EAAA,IAHA;AAIA,UAAA,UAAA,EAAA,EAJA;AAKA,UAAA,IAAA,EAAA,IAAA,CAAA,GAAA,CAAA,UAAA,IAAA;AAAA,mBAAA,IAAA,CAAA,IAAA;AAAA,WAAA,CALA;AAMA,UAAA,SAAA,EAAA;AACA,YAAA,OAAA,EAAA;AADA;AANA,SADA;AAlBA,OAAA;AA+BA,KAlKA;AAoKA,IAAA,YApKA,0BAoKA;AACA,UAAA,aAAA,GAAA,KAAA,SAAA,CAAA,eAAA,CAAA;;AACA,UAAA,aAAA,EAAA;AACA,QAAA,aAAA,CAAA,SAAA,CACA,KAAA,cAAA,CAAA,MAAA,EAAA,KAAA,aAAA,EAAA,CAAA,SAAA,EAAA,SAAA,EAAA,SAAA,CAAA,CADA;AAGA;;AAEA,UAAA,qBAAA,GAAA,KAAA,SAAA,CAAA,uBAAA,CAAA;;AACA,UAAA,qBAAA,EAAA;AACA,QAAA,qBAAA,CAAA,SAAA,CACA,KAAA,cAAA,CAAA,MAAA,EAAA,KAAA,qBAAA,EAAA,CAAA,SAAA,EAAA,SAAA,CAAA,CADA;AAGA;;AAEA,UAAA,sBAAA,GAAA,KAAA,SAAA,CAAA,wBAAA,CAAA;;AACA,UAAA,sBAAA,EAAA;AACA,QAAA,sBAAA,CAAA,SAAA,CACA,KAAA,cAAA,CAAA,MAAA,EAAA,KAAA,sBAAA,EAAA,SAAA,CADA;AAGA;;AAEA,UAAA,aAAA,GAAA,KAAA,SAAA,CAAA,eAAA,CAAA;;AACA,UAAA,aAAA,EAAA;AACA,QAAA,aAAA,CAAA,SAAA,CACA,KAAA,cAAA,CAAA,MAAA,EAAA,KAAA,aAAA,EAAA,SAAA,CADA;AAGA;;AAEA,UAAA,eAAA,GAAA,KAAA,SAAA,CAAA,iBAAA,CAAA;;AACA,UAAA,eAAA,EAAA;AACA,QAAA,eAAA,CAAA,SAAA,CACA,KAAA,eAAA,CAAA,QAAA,EAAA,KAAA,sBAAA,EAAA,SAAA,CADA;AAGA;;AAEA,UAAA,kBAAA,GAAA,KAAA,SAAA,CAAA,oBAAA,CAAA;;AACA,UAAA,kBAAA,EAAA;AACA,QAAA,kBAAA,CAAA,SAAA,CACA,KAAA,cAAA,CAAA,MAAA,EAAA,KAAA,qBAAA,EAAA,SAAA,EAAA;AACA,UAAA,WAAA,EAAA,EADA;AAEA,UAAA,UAAA,EAAA;AAFA,SAAA,CADA;AAMA;AACA;AAjNA;AAtCA,CAAA","sourcesContent":["<template>\n  <div class=\"statistics-page\">\n    <div class=\"board\">\n      <el-breadcrumb separator-class=\"el-icon-arrow-right\">\n        <el-breadcrumb-item :to=\"{ path: '/welcome' }\">首页</el-breadcrumb-item>\n        <el-breadcrumb-item>数据统计管理</el-breadcrumb-item>\n      </el-breadcrumb>\n    </div>\n\n    <el-row :gutter=\"20\" class=\"summary-row\">\n      <el-col :span=\"6\" v-for=\"card in summaryCards\" :key=\"card.key\">\n        <el-card shadow=\"hover\" class=\"summary-card\">\n          <div class=\"summary-label\">{{ card.label }}</div>\n          <div class=\"summary-value\">{{ summary[card.key] || 0 }}</div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <el-row :gutter=\"20\" class=\"chart-row\">\n      <el-col :span=\"12\">\n        <el-card shadow=\"never\" class=\"chart-card\">\n          <div class=\"chart-title\">用户角色分布</div>\n          <div ref=\"userRoleChart\" class=\"chart-box\"></div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"12\">\n        <el-card shadow=\"never\" class=\"chart-card\">\n          <div class=\"chart-title\">企业状态分布</div>\n          <div ref=\"enterpriseStatusChart\" class=\"chart-box\"></div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <el-row :gutter=\"20\" class=\"chart-row\">\n      <el-col :span=\"12\">\n        <el-card shadow=\"never\" class=\"chart-card\">\n          <div class=\"chart-title\">投递处理状态</div>\n          <div ref=\"applicationStatusChart\" class=\"chart-box\"></div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"12\">\n        <el-card shadow=\"never\" class=\"chart-card\">\n          <div class=\"chart-title\">岗位审核状态</div>\n          <div ref=\"jobAuditChart\" class=\"chart-box\"></div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <el-row :gutter=\"20\" class=\"chart-row\">\n      <el-col :span=\"12\">\n        <el-card shadow=\"never\" class=\"chart-card\">\n          <div class=\"chart-title\">近六个月岗位发布趋势</div>\n          <div ref=\"monthlyJobChart\" class=\"chart-box\"></div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"12\">\n        <el-card shadow=\"never\" class=\"chart-card\">\n          <div class=\"chart-title\">企业岗位数量排行</div>\n          <div ref=\"topEnterpriseChart\" class=\"chart-box\"></div>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport * as echarts from \"echarts\";\n\nexport default {\n  name: \"StatisticsDashboard\",\n  data() {\n    return {\n      loading: false,\n      summary: {\n        userCount: 0,\n        enterpriseCount: 0,\n        activeJobCount: 0,\n        applicationCount: 0,\n        resumeCount: 0,\n        commentCount: 0\n      },\n      summaryCards: [\n        { key: \"userCount\", label: \"普通用户数\" },\n        { key: \"enterpriseCount\", label: \"企业总数\" },\n        { key: \"activeJobCount\", label: \"在招岗位数\" },\n        { key: \"applicationCount\", label: \"简历投递数\" },\n        { key: \"resumeCount\", label: \"简历总数\" },\n        { key: \"commentCount\", label: \"评论总数\" }\n      ],\n      userRoleStats: [],\n      enterpriseStatusStats: [],\n      applicationStatusStats: [],\n      jobAuditStats: [],\n      monthlyJobPublishStats: [],\n      topEnterpriseJobStats: [],\n      chartInstances: {}\n    };\n  },\n  mounted() {\n    this.loadStatistics();\n    window.addEventListener(\"resize\", this.handleResize);\n  },\n  beforeDestroy() {\n    window.removeEventListener(\"resize\", this.handleResize);\n    this.disposeCharts();\n  },\n  methods: {\n    async loadStatistics() {\n      this.loading = true;\n      try {\n        const resp = await axios.get(\"dashboard/statistics\");\n        const data = (resp.data && resp.data.data) || {};\n        this.summary = {\n          ...this.summary,\n          ...(data.summary || {})\n        };\n        this.userRoleStats = data.userRoleStats || [];\n        this.enterpriseStatusStats = data.enterpriseStatusStats || [];\n        this.applicationStatusStats = data.applicationStatusStats || [];\n        this.jobAuditStats = data.jobAuditStats || [];\n        this.monthlyJobPublishStats = data.monthlyJobPublishStats || [];\n        this.topEnterpriseJobStats = data.topEnterpriseJobStats || [];\n\n        this.$nextTick(() => {\n          this.renderCharts();\n        });\n      } catch (error) {\n        this.$message.error(\"获取统计数据失败\");\n      } finally {\n        this.loading = false;\n      }\n    },\n\n    handleResize() {\n      Object.values(this.chartInstances).forEach(chart => {\n        if (chart) {\n          chart.resize();\n        }\n      });\n    },\n\n    disposeCharts() {\n      Object.keys(this.chartInstances).forEach(key => {\n        const chart = this.chartInstances[key];\n        if (chart) {\n          chart.dispose();\n        }\n      });\n      this.chartInstances = {};\n    },\n\n    initChart(refName) {\n      const dom = this.$refs[refName];\n      if (!dom) {\n        return null;\n      }\n\n      if (this.chartInstances[refName]) {\n        this.chartInstances[refName].dispose();\n      }\n\n      const instance = echarts.init(dom);\n      this.chartInstances[refName] = instance;\n      return instance;\n    },\n\n    buildPieOption(title, list, colors) {\n      return {\n        color: colors,\n        tooltip: {\n          trigger: \"item\"\n        },\n        legend: {\n          bottom: 0\n        },\n        series: [\n          {\n            name: title,\n            type: \"pie\",\n            radius: [\"45%\", \"72%\"],\n            center: [\"50%\", \"45%\"],\n            data: list.map(item => ({\n              name: item.name,\n              value: item.nums\n            })),\n            label: {\n              formatter: \"{b}\\n{c}\"\n            }\n          }\n        ]\n      };\n    },\n\n    buildBarOption(title, list, color, options = {}) {\n      const labelRotate = Number(options.labelRotate || 0);\n      const gridBottom = Number(options.gridBottom || 45);\n\n      return {\n        color: [color],\n        tooltip: {\n          trigger: \"axis\"\n        },\n        grid: {\n          left: 40,\n          right: 20,\n          top: 30,\n          bottom: gridBottom\n        },\n        xAxis: {\n          type: \"category\",\n          data: list.map(item => item.name),\n          axisLabel: {\n            interval: 0,\n            rotate: labelRotate,\n            align: labelRotate ? \"right\" : \"center\",\n            margin: labelRotate ? 18 : 8\n          }\n        },\n        yAxis: {\n          type: \"value\"\n        },\n        series: [\n          {\n            name: title,\n            type: \"bar\",\n            barMaxWidth: 42,\n            data: list.map(item => item.nums),\n            label: {\n              show: true,\n              position: \"top\"\n            }\n          }\n        ]\n      };\n    },\n\n    buildLineOption(title, list, color) {\n      return {\n        color: [color],\n        tooltip: {\n          trigger: \"axis\"\n        },\n        grid: {\n          left: 40,\n          right: 20,\n          top: 30,\n          bottom: 35\n        },\n        xAxis: {\n          type: \"category\",\n          data: list.map(item => item.name)\n        },\n        yAxis: {\n          type: \"value\"\n        },\n        series: [\n          {\n            name: title,\n            type: \"line\",\n            smooth: true,\n            symbolSize: 10,\n            data: list.map(item => item.nums),\n            areaStyle: {\n              opacity: 0.12\n            }\n          }\n        ]\n      };\n    },\n\n    renderCharts() {\n      const userRoleChart = this.initChart(\"userRoleChart\");\n      if (userRoleChart) {\n        userRoleChart.setOption(\n          this.buildPieOption(\"用户角色\", this.userRoleStats, [\"#07c160\", \"#3b82f6\", \"#f59e0b\"])\n        );\n      }\n\n      const enterpriseStatusChart = this.initChart(\"enterpriseStatusChart\");\n      if (enterpriseStatusChart) {\n        enterpriseStatusChart.setOption(\n          this.buildPieOption(\"企业状态\", this.enterpriseStatusStats, [\"#10b981\", \"#ff6b6b\"])\n        );\n      }\n\n      const applicationStatusChart = this.initChart(\"applicationStatusChart\");\n      if (applicationStatusChart) {\n        applicationStatusChart.setOption(\n          this.buildBarOption(\"投递数量\", this.applicationStatusStats, \"#6366f1\")\n        );\n      }\n\n      const jobAuditChart = this.initChart(\"jobAuditChart\");\n      if (jobAuditChart) {\n        jobAuditChart.setOption(\n          this.buildBarOption(\"岗位数量\", this.jobAuditStats, \"#14b8a6\")\n        );\n      }\n\n      const monthlyJobChart = this.initChart(\"monthlyJobChart\");\n      if (monthlyJobChart) {\n        monthlyJobChart.setOption(\n          this.buildLineOption(\"岗位发布趋势\", this.monthlyJobPublishStats, \"#f97316\")\n        );\n      }\n\n      const topEnterpriseChart = this.initChart(\"topEnterpriseChart\");\n      if (topEnterpriseChart) {\n        topEnterpriseChart.setOption(\n          this.buildBarOption(\"岗位数量\", this.topEnterpriseJobStats, \"#8b5cf6\", {\n            labelRotate: 35,\n            gridBottom: 90\n          })\n        );\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.statistics-page {\n  padding: 0 20px 20px;\n}\n\n.board {\n  margin-bottom: 20px;\n}\n\n.summary-row,\n.chart-row {\n  margin-bottom: 20px;\n}\n\n.summary-card {\n  border-radius: 16px;\n}\n\n.summary-label {\n  font-size: 14px;\n  color: #8a8f99;\n}\n\n.summary-value {\n  margin-top: 12px;\n  font-size: 30px;\n  font-weight: 700;\n  color: #1f2937;\n}\n\n.chart-card {\n  border-radius: 16px;\n}\n\n.chart-title {\n  margin-bottom: 12px;\n  font-size: 16px;\n  font-weight: 600;\n  color: #1f2937;\n}\n\n.chart-box {\n  height: 360px;\n}\n</style>\n"],"sourceRoot":"src/views/vaccine"}]}