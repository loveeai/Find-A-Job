EA;AAoEA,IAAA,QApEA,sBAoEA;AAAA;;AAAA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,uBACA,MAAA,CAAA,UAAA,EADA;;AAAA;AAEA,gBAAA,MAAA,CAAA,SAAA,CAAA,WAAA,GAAA,MAAA,CAAA,WAAA,CAAA,MAAA,GAAA,IAAA,CAAA,SAAA,CAAA,MAAA,CAAA,WAAA,CAAA,GAAA,EAAA;AACA,gBAAA,KAHA,GAGA,MAHA;AAIA,gBAAA,OAJA,GAIA,IAJA;AAKA,gBAAA,KAAA,CAAA,QAAA,CAAA,OAAA,CAAA,GAAA,CAAA,cAAA,IAAA,kBAAA;AALA;AAAA,uBAMA,KAAA,CAAA,GAAA,CAAA,SAAA,EAAA,IAAA,CAAA,SAAA,CAAA,MAAA,CAAA,SAAA,CAAA,EAAA,IAAA,CAAA,UAAA,IAAA,EAAA;AACA,sBAAA,IAAA,CAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,oBAAA,MAAA,CAAA,QAAA,CAAA,KAAA,CAAA,WAAA;;AACA,oBAAA,OAAA,GAAA,KAAA;AACA;AACA,iBALA,CANA;;AAAA;AAAA,oBAYA,OAZA;AAAA;AAAA;AAAA;;AAAA;;AAAA;AAaA,gBAAA,MAAA,CAAA,QAAA,CAAA,OAAA,CAAA,WAAA;;AACA,gBAAA,MAAA,CAAA,IAAA,GAAA,EAAA;AACA,gBAAA,MAAA,CAAA,WAAA,GAAA,EAAA;;AACA,gBAAA,MAAA,CAAA,OAAA;;AACA,gBAAA,MAAA,CAAA,SAAA,GAAA,KAAA;;AAjBA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAkBA,KAtFA;AAuFA,IAAA,UAvFA,wBAuFA;AAAA;;AAAA;AAAA;;AAAA;AAAA;AAAA;AAAA;AACA,gBAAA,KADA,GACA,MADA;AAEA,gBAAA,MAAA,CAAA,WAAA,GAAA,EAAA;AACA,gBAAA,CAHA,GAGA,CAHA;;AAAA;AAAA,sBAGA,CAAA,GAAA,MAAA,CAAA,IAAA,CAAA,MAHA;AAAA;AAAA;AAAA;;AAIA,gBAAA,QAJA,GAIA,IAAA,QAAA,EAJA;;AAAA,sBAKA,MAAA,CAAA,IAAA,CAAA,CAAA,EAAA,MAAA,KAAA,SALA;AAAA;AAAA;AAAA;;AAMA,gBAAA,CANA,GAMA,MAAA,CAAA,IAAA,CAAA,CAAA,EAAA,GANA;;AAOA,gBAAA,MAAA,CAAA,WAAA,CAAA,IAAA,CAAA,CAAA,CAAA,SAAA,CAAA,CAAA,CAAA,OAAA,CAAA,SAAA,CAAA,CAAA;;AAPA;;AAAA;AAUA,gBAAA,IAVA,GAUA,MAAA,CAAA,IAAA,CAAA,CAAA,EAAA,GAVA;AAWA,gBAAA,QAAA,CAAA,MAAA,CAAA,MAAA,EAAA,IAAA;AAXA;AAAA,uBAYA,KAAA,CAAA,IAAA,CAAA,aAAA,EAAA,QAAA,EAAA,IAAA,CAAA,UAAA,QAAA,EAAA;AACA,kBAAA,OAAA,CAAA,GAAA,CAAA,QAAA;;AACA,kBAAA,KAAA,CAAA,WAAA,CAAA,IAAA,CAAA,QAAA,CAAA,IAAA,CAAA,IAAA;AACA,iBAHA,CAZA;;AAAA;AAGA,gBAAA,CAAA,EAHA;AAAA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAiBA,KAxGA;AAyGA,IAAA,YAzGA,0BAyGA;AACA,WAAA,QAAA,CAAA,KAAA,CAAA,aAAA;AACA;AA3GA,GAhBA;AA6HA,EAAA,OA7HA,qBA6HA;AACA,SAAA,OAAA;AACA;AA/HA,CAAA","sourcesContent":["<template>\r\n    <div style=\"box-sizing:border-box\">\r\n        <div class=\"user-info-container\">\r\n            <h1>我的个人信息</h1>\r\n            <div style=\"width: 100%;margin-top:30px;\">\r\n                <el-form :model=\"loginUser\" ref=\"editFormRef\" label-width=\"150px\" :label-position=\"'left'\"\r\n                    style=\"margin-left:50px\">\r\n                    <el-form-item label=\"头像\">\r\n                        <el-upload action=\"\" list-type=\"picture-card\" :auto-upload=\"false\" :limit=\"1\" :file-list=\"pics\"\r\n                            :on-change=\"handleChange\" :on-success=\"handleSuccess\" :on-error=\"handleError\"\r\n                            :on-exceed=\"handleExceed\" ref=\"pictureRef\" :http-request=\"submitFile\">\r\n                            <i slot=\"default\" class=\"el-icon-plus\"></i>\r\n                            <div slot=\"file\" slot-scope=\"{file}\">\r\n                                <img class=\"el-upload-list__item-thumbnail\"\r\n                                    :src=\"(picDialog ? '' : global.base) + file.url\" alt=\"\">\r\n                                <span class=\"el-upload-list__item-actions\">\r\n                                    <span class=\"el-upload-list__item-delete\" @click=\"handleRemove(file)\">\r\n                                        <i class=\"el-icon-delete\"></i>\r\n                                    </span>\r\n                                </span>\r\n                            </div>\r\n                        </el-upload>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"昵称\" prop=\"userName\">\r\n                        <el-input v-model=\"loginUser.userName\" disabled></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"密码\" prop=\"password\">\r\n                        <el-input v-model=\"loginUser.password\" type=\"password\" show-password clearable></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"邮箱\" prop=\"email\">\r\n                        <el-input v-model=\"loginUser.email\"></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"手机号\" prop=\"phoneNumber\">\r\n                        <el-input v-model=\"loginUser.phoneNumber\"></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"性别\" prop=\"sex\">\r\n                        <el-radio v-model=\"loginUser.sex\" :label=\"true\">男</el-radio>\r\n                        <el-radio v-model=\"loginUser.sex\" :label=\"false\">女</el-radio>\r\n                    </el-form-item>\r\n                    <el-button type=\"primary\" @click=\"editUser\"\r\n                        style=\"width:120px;background-color:chocolate ;border:#00cc7e\" >保存</el-button>\r\n                </el-form>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: \"personal\",\r\n    data() {\r\n        return {\r\n            addForm:{},\r\n            ordersId: '',\r\n            userId: 0,\r\n            user: {},\r\n            picDialog: false,\r\n            loginUser: {},\r\n            pics: [],\r\n            pictureList: [],\r\n            picSrc: \"\",\r\n            deletePicList: [],\r\n        }\r\n    },\r\n    methods: {\n        normalizePictureList(value) {\n            if (!value) {\n                return []\n            }\n            if (Array.isArray(value)) {\n                return value.filter(Boolean)\n            }\n            if (typeof value === 'string') {\n                const text = value.trim()\n                if (!text) {\n                    return []\n                }\n                if (text.startsWith('[') || text.startsWith('{')) {\n                    try {\n                        const parsed = JSON.parse(text)\n                        if (Array.isArray(parsed)) {\n                            return parsed.filter(Boolean)\n                        }\n                        if (parsed && typeof parsed === 'object') {\n                            return [parsed.url || parsed.path || parsed.src].filter(Boolean)\n                        }\n                    } catch (error) {\n                        return [text]\n                    }\n                }\n                return [text]\n            }\n            if (typeof value === 'object') {\n                return [value.url || value.path || value.src].filter(Boolean)\n            }\n            return []\n        },\n        async getUser() {\n            const { data: res } = await axios.get('sysUser/' + JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser.userId)\n            console.log(res)\n            this.loginUser = res.data\n            const pictureList = this.normalizePictureList(this.loginUser.userPicture)\n            this.pics = pictureList.map(item => ({\n                name: 'picture',\n                url: item.startsWith('http') ? item : item,\n                status: 'success'\n            }))\n        },\n        async handleSuccess(response, file, fileList) {\r\n            this.pics = fileList\r\n            console.log(this.pics)\r\n            await this.submitFile()\r\n            this.picSrc = this.pictureList[0]\r\n        },\r\n        handleError(err) {\r\n            console.log(err)\r\n        },\r\n        handleChange(file, filelist) {\r\n            this.pics = filelist.slice(0)\r\n            console.log(111)\r\n            console.log(this.pics)\r\n            this.picDialog = true\r\n        },\r\n        handleRemove(file) {\r\n            const filePath = file.url\r\n            console.log(filePath)\r\n            const idx = this.pics.findIndex(x => x.url === filePath)\r\n            if (file.status === 'success') {\r\n                this.deletePicList.push(file.url)\r\n            }\r\n            this.pics.splice(idx, 1)\r\n        },\r\n        async editUser() {\n            await this.submitFile()\n            this.loginUser.userPicture = this.pictureList.length ? JSON.stringify(this.pictureList) : ''\n            const _this = this\n            let success = true\n            axios.defaults.headers.put['Content-Type'] = 'application/json'\r\n            await axios.put('sysUser', JSON.stringify(this.loginUser)).then(resp => {\r\n                if (resp.data.code !== 200) {\r\n                    this.$message.error('修改用户信息失败！')\r\n                    success = false\r\n                }\r\n            })\r\n            if (!success) return\r\n            this.$message.success('修改用户信息成功!')\r\n            this.pics = []\r\n            this.pictureList = []\r\n            this.getUser()\r\n            this.picDialog = false\r\n        },\r\n        async submitFile() {\n            const _this = this\n            this.pictureList = []\n            for (let i = 0; i < this.pics.length; i++) {\n                let formData = new FormData()\n                if (this.pics[i].status === 'success') {\r\n                    let s = this.pics[i].url\r\n                    this.pictureList.push(s.substring(s.indexOf('/images')))\r\n                    continue\r\n                }\r\n                let file = this.pics[i].raw\r\n                formData.append('file', file)\r\n                await axios.post('upload/user', formData).then(response => {\r\n                    console.log(response)\r\n                    _this.pictureList.push(response.data.data)\r\n                })\r\n            }\r\n        },\r\n        handleExceed() {\r\n            this.$message.error(\"用户头像最多上传一张！\")\r\n        },\r\n    },\r\n    created() {\r\n        this.getUser()\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.user-info-container {\r\n    background-color: white;\r\n    padding: 50px\r\n}\r\n</style>\n"],"sourceRoot":"src/views/user"}]}