AAA,UAAA,OAAA,EAAA,cAAA;AAAA,UAAA,OAAA,EAAA;AAAA,SAFA,CADA;AAMA,QAAA,QAAA,EAAA,CACA;AAAA,UAAA,QAAA,EAAA,IAAA;AAAA,UAAA,OAAA,EAAA,OAAA;AAAA,UAAA,OAAA,EAAA;AAAA,SADA,EAEA;AAAA,UAAA,GAAA,EAAA,CAAA;AAAA,UAAA,GAAA,EAAA,EAAA;AAAA,UAAA,OAAA,EAAA,cAAA;AAAA,UAAA,OAAA,EAAA;AAAA,SAFA,CANA;AAUA,QAAA,WAAA,EAAA,CACA;AAAA,UAAA,QAAA,EAAA,IAAA;AAAA,UAAA,OAAA,EAAA,SAAA;AAAA,UAAA,OAAA,EAAA;AAAA,SADA,CAVA;AAaA,QAAA,eAAA,EAAA,CACA;AAAA,UAAA,QAAA,EAAA,IAAA;AAAA,UAAA,SAAA,EAAA,YAAA;AAAA,UAAA,OAAA,EAAA,WAAA;AAAA,UAAA,OAAA,EAAA;AAAA,SADA;AAbA;AARA,KAAA;AA0BA,GA9CA;AA+CA,EAAA,OAAA,EAAA;AACA,IAAA,QADA,sBACA;AAAA;;AACA,WAAA,KAAA,CAAA,eAAA,CAAA,QAAA;AAAA,2EAAA,iBAAA,KAAA;AAAA;;AAAA;AAAA;AAAA;AAAA;AAAA,sBACA,KADA;AAAA;AAAA;AAAA;;AAAA;;AAAA;AAEA,kBAAA,MAAA,CAAA,YAAA,CAAA,MAAA,GAAA,CAAA;AACA,kBAAA,MAAA,CAAA,YAAA,CAAA,GAAA,GAAA,MAAA,CAAA,MAAA,KAAA,GAAA;AACA,kBAAA,KAAA,CAAA,QAAA,CAAA,OAAA,CAAA,IAAA,CAAA,cAAA,IAAA,kBAAA;AAJA;AAAA,yBAKA,KAAA,CAAA,IAAA,CAAA,SAAA,EAAA,IAAA,CAAA,SAAA,CAAA,MAAA,CAAA,YAAA,CAAA,CALA;;AAAA;AAAA;AAKA,kBAAA,GALA,qBAKA,IALA;;AAAA,wBAMA,GAAA,CAAA,IAAA,IAAA,GANA;AAAA;AAAA;AAAA;;AAAA,mDAMA,MAAA,CAAA,QAAA,CAAA,KAAA,CAAA,GAAA,CAAA,GAAA,CANA;;AAAA;AAQA,kBAAA,MAAA,CAAA,QAAA,CAAA,OAAA,CAAA,OAAA;;AACA,kBAAA,MAAA,CAAA,OAAA,CAAA,IAAA,CAAA,QAAA;;AACA,kBAAA,MAAA,CAAA,KAAA,CAAA,eAAA,CAAA,WAAA;;AAVA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,SAAA;;AAAA;AAAA;AAAA;AAAA;AAYA,KAdA;AAeA,IAAA,SAfA,uBAeA;AACA,WAAA,OAAA,CAAA,IAAA,CAAA,UAAA;AACA;AAjBA;AA/CA,CAAA","sourcesContent":["<template>\r\n  <div class=\"register-container\">\r\n    <!-- <div class=\"header\" @click=\"toWelcome\">\r\n      <img src=\"../assets/registerLogo.jpg\" style=\"width: 230px; height: 54px;\">\r\n    </div> -->\r\n    <div class=\"register-body\">\r\n      <el-form class=\"register-form\" ref=\"registerFormRef\" :model=\"registerForm\" :rules=\"registerFormRules\" label-width=\"80px\">\r\n        <el-form-item label=\"用户名\" prop=\"userName\">\r\n          <el-input v-model=\"registerForm.userName\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"密码\" prop=\"password\">\r\n          <el-input v-model=\"registerForm.password\" type=\"password\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"联系方式\" prop=\"phoneNumber\">\r\n          <el-input v-model=\"registerForm.phoneNumber\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"性别\">\r\n          <el-radio v-model=\"gender\" label=\"0\">女</el-radio>\r\n          <el-radio v-model=\"gender\" label=\"1\">男</el-radio>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" @click=\"register\">同意以下协议并注册</el-button>\r\n        </el-form-item>\r\n        <el-form-item id=\"protocal\">\r\n          <el-link type=\"primary\" style=\"line-height: 14px;\">《暂无协议》</el-link>\r\n        </el-form-item>\r\n      </el-form>\r\n      <!-- <img src=\"../assets/register.png\"> -->\r\n    </div>\r\n    <div class=\"footer-mini\"></div>\r\n     <div class=\"footer\">\r\n      Copyright (c) 2024-2024 fmy\r\n    </div> \r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Register\",\r\n  data() {\r\n    let checkEmail = (rule, value, cb) => {\r\n      const regEmail = /^([a-zA-Z0-9_-])+@([a-zA-Z0-9_-])+(\\.[a-zA-Z0-9_-])+/\r\n      if (regEmail.test(value)){\r\n        return cb()\r\n      }\r\n      cb(new Error('请输入合法的邮箱'))\r\n    }\r\n    var validatePass = (rule, value, callback) => {\r\n      if (value === '') {\r\n        callback(new Error('请再次输入密码'))\r\n        // password 是表单上绑定的字段\r\n      } else if (value !== this.registerForm.password) {\r\n        callback(new Error('两次输入密码不一致!'))\r\n      } else {\r\n        callback()\r\n      }\r\n    }\r\n    return {\r\n      gender: '0',\r\n      registerForm: {\r\n        userName: '',\r\n        password: '',\r\n        confirmPassword: '',\r\n        sex: '',\r\n      },\r\n      registerFormRules: {\r\n        userName: [\r\n          { required: true, message: \"请输入用户名称\", trigger: \"blur\"},\r\n          { min: 2, max: 20, message: \"长度在2到20个字符之间\", trigger: \"blur\"}\r\n        ],\r\n      \r\n        password: [\r\n          { required: true, message: \"请输入密码\", trigger: \"blur\"},\r\n          { min:6, max: 16, message: \"长度在6到16个字符之间\", trigger: \"blur\"}\r\n        ],\r\n        phoneNumber: [\r\n          { required: true, message: \"请输入联系方式\", trigger: \"blur\"},\r\n        ],\r\n        confirmPassword: [\r\n          { required: true, validator: validatePass, message: \"两次密码输入不一致\", trigger: \"blur\"},\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  methods:{\r\n    register(){\r\n      this.$refs.registerFormRef.validate(async valid =>{\r\n        if(!valid) return\r\n        this.registerForm.roleId = 2;\r\n        this.registerForm.sex = this.gender === '1'\r\n        axios.defaults.headers.post['Content-Type'] = 'application/json'\r\n        const { data: res} = await axios.post('sysUser', JSON.stringify(this.registerForm));\r\n        if(res.code != 200) return this.$message.error(res.msg);\r\n\r\n        this.$message.success(\"注册完成！\");\r\n        this.$router.push('/login')\r\n        this.$refs.registerFormRef.resetFields()\r\n      })\r\n    },\r\n    toWelcome(){\r\n      this.$router.push('/welcome')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.register-container{\r\n  width: 100%;\r\n  height: 100%;\r\n  text-align: center;\r\n  background-color: rgb(235, 240, 243);\r\n}\r\n\r\n.header{\r\n  height: 60px;\r\n  border-bottom: deepskyblue solid 2px;\r\n  padding-top: 6px;\r\n  padding-left: 500px;\r\n  padding-bottom: 0;\r\n  cursor: pointer;\r\n}\r\n\r\n.register-body{\r\n  display: flex;\r\n  padding-top: 50px;\r\n}\r\n\r\n.register-form{\r\n  width: 20%;\r\n  margin-left: 37%;\r\n  margin-right: 5%;\r\n}\r\n\r\n.footer-mini{\r\n  border-top: 1px solid #EEE;\r\n  padding-top: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.footer{\r\n  margin-top: 20px;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n</style>"],"sourceRoot":"src/views"}]}