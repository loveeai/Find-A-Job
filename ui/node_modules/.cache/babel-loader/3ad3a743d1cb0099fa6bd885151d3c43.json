template>\n            <el-menu-item v-for=\"subItem in item.children\" :key=\"subItem.id\" :index=\"'/' + subItem.path\">\n              <i class=\"el-icon-arrow-right\"></i>\n              <span>{{ subItem.name }}</span>\n            </el-menu-item>\n          </el-submenu>\n        </el-menu>\n      </el-aside>\n\n      <el-main>\n        <router-view></router-view>\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nexport default {\n  name: \"Home\",\n  data() {\n    return {\n      menulist: [\n        {\n          id: 1,\n          name: \"用户信息管理\",\n          children: [\n            { id: 1, path: \"user2\", name: \"普通用户管理\" },\n            { id: 2, path: \"user\", name: \"企业用户管理\" }\n          ]\n        },\n        {\n          id: 2,\n          name: \"招聘信息管理\",\n          children: [\n            { id: 1, path: \"jobCategory\", name: \"岗位分类管理\" },\n            { id: 2, path: \"jobInfo\", name: \"招聘岗位管理\" },\n            { id: 3, path: \"jobAudit\", name: \"招聘信息审核\" },\n            { id: 4, path: \"enterprise\", name: \"企业信息管理\" },\n            { id: 5, path: \"comment\", name: \"评论管理\" },\n            { id: 6, path: \"complaint\", name: \"投诉管理\" }\n          ]\n        },\n        {\n          id: 3,\n          name: \"系统信息管理\",\n          children: [\n            { id: 1, path: \"carousel\", name: \"轮播图管理\" },\n            { id: 2, path: \"statistics\", name: \"数据统计管理\" }\n          ]\n        }\n      ],\n      isCollapsed: false\n    };\n  },\n  methods: {\n    toggleCollapse() {\n      this.isCollapsed = !this.isCollapsed;\n    },\n    toWelcome() {\n      this.$router.push(\"/statistics\");\n    },\n    handleCommand() {\n      window.sessionStorage.clear();\n      this.$router.push(\"/login\");\n    }\n  }\n};\n</script>\n\n<style scoped>\n.home-container {\n  height: 100%;\n}\n\n.el-header {\n  background-color: #39424b;\n  display: flex;\n  justify-content: space-between;\n  padding: 0 24px 0 14px;\n  align-items: center;\n  color: whitesmoke;\n  font-size: 20px;\n}\n\n.el-aside {\n  background-color: #39424b;\n}\n\n.toggle-button {\n  background-color: #4a5064;\n  font-size: 10px;\n  line-height: 24px;\n  color: #fff;\n  text-align: center;\n  letter-spacing: 0.1em;\n  cursor: pointer;\n}\n\n.span-container {\n  cursor: pointer;\n  font-weight: 600;\n}\n\n.el-main {\n  background-color: #f5f5f5;\n}\n\n.el-menu {\n  border: 0;\n}\n\n.el-dropdown-link {\n  cursor: pointer;\n  color: #409eff;\n}\n\n.el-icon-arrow-down {\n  font-size: 12px;\n}\n</style>\n"],"sourceRoot":"src/views"}]}