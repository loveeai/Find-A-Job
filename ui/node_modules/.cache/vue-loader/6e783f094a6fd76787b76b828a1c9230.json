{"remainingRequest":"D:\\bishe\\2026\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\bishe\\2026\\job\\study\\ui\\src\\views\\vaccine\\JobAudit.vue?vue&type=style&index=0&id=694635d4&scoped=true&lang=css&","dependencies":[{"path":"D:\\bishe\\2026\\job\\study\\ui\\src\\views\\vaccine\\JobAudit.vue","mtime":1766503184415},{"path":"D:\\bishe\\2026\\job\\study\\ui\\node_modules\\css-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\2026\\job\\study\\ui\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":499162500000},{"path":"D:\\bishe\\2026\\job\\study\\ui\\node_modules\\postcss-loader\\src\\index.js","mtime":499162500000},{"path":"D:\\bishe\\2026\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\2026\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["JobAudit.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoSA;AACA;AACA;AACA;AACA;AACA","file":"JobAudit.vue","sourceRoot":"src/views/vaccine","sourcesContent":["<template>\r\n  <div>\r\n    <!--面包屑导航区域-->\r\n    <div class=\"board\">\r\n      <el-breadcrumb separator-class=\"el-icon-arrow-right\">\r\n        <el-breadcrumb-item :to=\"{ path: '/welcome' }\">首页</el-breadcrumb-item>\r\n        <el-breadcrumb-item>招聘管理</el-breadcrumb-item>\r\n        <el-breadcrumb-item>招聘信息审核</el-breadcrumb-item>\r\n      </el-breadcrumb>\r\n    </div>\r\n\r\n    <!--卡片视图-->\r\n    <el-card class=\"box-card\">\r\n      <el-row :gutter=\"20\">\r\n        <el-col :span=\"6\">\r\n          <el-input placeholder=\"请输入岗位标题\" v-model=\"inputTitle\" clearable />\r\n        </el-col>\r\n        <el-col :span=\"6\">\r\n          <el-select v-model=\"selectedEnterpriseId\" placeholder=\"请选择企业\" clearable>\r\n            <el-option v-for=\"item in enterpriseList\" :key=\"item.id\" :label=\"item.name\" :value=\"item.id\"></el-option>\r\n          </el-select>\r\n        </el-col>\r\n        <el-col :span=\"6\">\r\n          <el-select v-model=\"selectedAuditStatus\" placeholder=\"审核状态\" clearable>\r\n            <el-option label=\"待审核\" :value=\"2\"></el-option>\r\n            <el-option label=\"审核通过\" :value=\"1\"></el-option>\r\n            <el-option label=\"未通过审核\" :value=\"3\"></el-option>\r\n          </el-select>\r\n        </el-col>\r\n        <el-col :span=\"3\">\r\n          <el-button icon=\"el-icon-search\" @click=\"getJobList\">搜索</el-button>\r\n        </el-col>\r\n        <el-col :span=\"3\">\r\n          <el-button type=\"primary\" @click=\"handleBatchAudit(1)\" style=\"background-color: #67C23A;\">批量通过</el-button>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-table :data=\"jobList\" style=\"width: 100%\" border stripe @selection-change=\"handleSelectionChange\" :row-class-name=\"tableRowClassName\">\r\n        <el-table-column type=\"selection\" width=\"40\"></el-table-column>\r\n        <el-table-column type=\"index\" label=\"#\" width=\"50\"></el-table-column>\r\n        <el-table-column prop=\"title\" label=\"岗位标题\" width=\"180\"></el-table-column>\r\n        <el-table-column prop=\"enterpriseId\" label=\"所属企业\" width=\"150\" :formatter=\"enterpriseFormat\"></el-table-column>\r\n        <el-table-column prop=\"categoryId\" label=\"岗位类别\" width=\"120\" :formatter=\"jobCategoryFormat\"></el-table-column>\r\n        <el-table-column label=\"薪资范围\" width=\"150\">\r\n          <template slot-scope=\"scope\">\r\n            {{scope.row.salaryMin}}-{{scope.row.salaryMax}} 元/月\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"education\" label=\"学历\" width=\"100\"></el-table-column>\r\n        <el-table-column prop=\"experience\" label=\"经验\" width=\"100\"></el-table-column>\r\n        <el-table-column prop=\"location\" label=\"工作地点\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"审核状态\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tag v-if=\"scope.row.status === 2\" type=\"warning\">待审核</el-tag>\r\n            <el-tag v-else-if=\"scope.row.status === 1\" type=\"success\">审核通过</el-tag>\r\n            <el-tag v-else-if=\"scope.row.status === 3\" type=\"danger\">未通过</el-tag>\r\n            <el-tag v-else type=\"info\">禁用</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"180\"></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"250\" fixed=\"right\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tooltip effect=\"dark\" content=\"查看详情\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button type=\"info\" size=\"mini\" @click=\"showJobDetail(scope.row)\">详情</el-button>\r\n            </el-tooltip>\r\n            <el-tooltip effect=\"dark\" content=\"审核通过\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\" v-if=\"scope.row.status === 2\">\r\n              <el-button type=\"success\" size=\"mini\" @click=\"handleAudit(scope.row.id, 1)\">通过</el-button>\r\n            </el-tooltip>\r\n            <el-tooltip effect=\"dark\" content=\"审核不通过\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\" v-if=\"scope.row.status === 2\">\r\n              <el-button type=\"danger\" size=\"mini\" @click=\"handleAudit(scope.row.id, 3)\">不通过</el-button>\r\n            </el-tooltip>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <!--分页区域-->\r\n      <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\r\n        :current-page=\"queryInfo.pageNum\" :page-sizes=\"[5, 7, 10, 15]\" :page-size=\"queryInfo.pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\" :total=\"total\">\r\n      </el-pagination>\r\n    </el-card>\r\n\r\n    <!--招聘详情对话框-->\r\n    <el-dialog title=\"招聘详情\" :visible.sync=\"detailDialogVisible\" width=\"60%\">\r\n      <el-descriptions :column=\"2\" border v-if=\"currentJob\">\r\n        <el-descriptions-item label=\"岗位标题\">{{currentJob.title}}</el-descriptions-item>\r\n        <el-descriptions-item label=\"所属企业\">{{enterpriseFormat(currentJob)}}</el-descriptions-item>\r\n        <el-descriptions-item label=\"岗位类别\">{{jobCategoryFormat(currentJob)}}</el-descriptions-item>\r\n        <el-descriptions-item label=\"工作地点\">{{currentJob.location}}</el-descriptions-item>\r\n        <el-descriptions-item label=\"最低薪资\">{{currentJob.salaryMin}} 元/月</el-descriptions-item>\r\n        <el-descriptions-item label=\"最高薪资\">{{currentJob.salaryMax}} 元/月</el-descriptions-item>\r\n        <el-descriptions-item label=\"学历要求\">{{currentJob.education}}</el-descriptions-item>\r\n        <el-descriptions-item label=\"经验要求\">{{currentJob.experience}}</el-descriptions-item>\r\n        <el-descriptions-item label=\"审核状态\">\r\n          <el-tag v-if=\"currentJob && currentJob.status === 2\" type=\"warning\">待审核</el-tag>\r\n          <el-tag v-else-if=\"currentJob && currentJob.status === 1\" type=\"success\">审核通过</el-tag>\r\n          <el-tag v-else-if=\"currentJob && currentJob.status === 3\" type=\"danger\">未通过</el-tag>\r\n          <el-tag v-else type=\"info\">禁用</el-tag>\r\n        </el-descriptions-item>\r\n        <el-descriptions-item label=\"创建时间\">{{currentJob.createTime}}</el-descriptions-item>\r\n        <el-descriptions-item label=\"岗位描述\" :span=\"2\">\r\n          <div style=\"white-space: pre-wrap;\">{{currentJob.description || '暂无描述'}}</div>\r\n        </el-descriptions-item>\r\n        <el-descriptions-item label=\"福利待遇\" :span=\"2\">\r\n          <div style=\"white-space: pre-wrap;\">{{currentJob.welfare || '暂无'}}</div>\r\n        </el-descriptions-item>\r\n      </el-descriptions>\r\n      <span slot=\"footer\" class=\"dialog-footer\" v-if=\"currentJob\">\r\n        <el-button @click=\"detailDialogVisible = false\">关 闭</el-button>\r\n        <el-button type=\"success\" @click=\"handleAudit(currentJob.id, 1)\" v-if=\"currentJob.status === 2\">审核通过</el-button>\r\n        <el-button type=\"danger\" @click=\"handleAudit(currentJob.id, 3)\" v-if=\"currentJob.status === 2\">审核不通过</el-button>\r\n      </span>\r\n      <span slot=\"footer\" class=\"dialog-footer\" v-else>\r\n        <el-button @click=\"detailDialogVisible = false\">关 闭</el-button>\r\n      </span>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport global from \"@/assets/css/global.css\";\r\nexport default {\r\n  data() {\r\n    return {\r\n      queryInfo: {\r\n        title: \"\",\r\n        enterpriseId: null,\r\n        status: 2, // 默认显示待审核的招聘信息\r\n        pageNum: 1,\r\n        pageSize: 10,\r\n      },\r\n      total: 0,\r\n      inputTitle: \"\",\r\n      selectedEnterpriseId: \"\",\r\n      selectedAuditStatus: 2,\r\n      jobList: [],\r\n      enterpriseList: [],\r\n      jobCategoryList: [],\r\n      multipleSelection: [],\r\n      detailDialogVisible: false,\r\n      currentJob: null,\r\n    };\r\n  },\r\n  created() {\r\n    this.getJobList();\r\n    this.getEnterpriseList();\r\n    this.getJobCategoryList();\r\n  },\r\n  methods: {\r\n    getJobList() {\r\n      this.queryInfo.title = this.inputTitle;\r\n      this.queryInfo.enterpriseId = this.selectedEnterpriseId ? parseInt(this.selectedEnterpriseId) : null;\r\n      this.queryInfo.status = this.selectedAuditStatus !== '' ? parseInt(this.selectedAuditStatus) : null;\r\n      const _this = this;\r\n      this.$axios.get(\"job\", { params: _this.queryInfo }).then((resp) => {\r\n        _this.jobList = resp.data.data;\r\n        _this.total = resp.data.total;\r\n        _this.queryInfo.pageSize = resp.data.pageSize;\r\n        _this.queryInfo.pageNum = resp.data.pageNum;\r\n      });\r\n    },\r\n    getEnterpriseList() {\r\n      const _this = this;\r\n      axios.get(\"enterprise\", { params: { pageSize: 100 } }).then((resp) => {\r\n        _this.enterpriseList = resp.data.data;\r\n      });\r\n    },\r\n    getJobCategoryList() {\r\n      const _this = this;\r\n      axios.get(\"jobCategory\", { params: { pageSize: 100 } }).then((resp) => {\r\n        _this.jobCategoryList = resp.data.data;\r\n      });\r\n    },\r\n    handleSizeChange(newSize) {\r\n      this.queryInfo.pageSize = newSize;\r\n      this.getJobList();\r\n    },\r\n    handleCurrentChange(newPage) {\r\n      this.queryInfo.pageNum = newPage;\r\n      this.getJobList();\r\n    },\r\n    // 监听多选框变化\r\n    handleSelectionChange(val) {\r\n      this.multipleSelection = val;\r\n    },\r\n    // 审核操作\r\n    async handleAudit(id, status) {\r\n      const statusText = status === 1 ? '通过' : '不通过';\r\n      const resp = await this.$confirm(\r\n        `确定要审核${statusText}吗？`,\r\n        '提示',\r\n        {\r\n          confirmButtonText: '确定',\r\n          cancelButtonText: '取消',\r\n          type: 'warning',\r\n        }\r\n      ).catch((err) => err);\r\n\r\n      if (resp == \"cancel\") {\r\n        return this.$message.info(\"已取消操作\");\r\n      }\r\n\r\n      const _this = this;\r\n      axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n      await axios\r\n        .put(\"job\", JSON.stringify({ id: id, status: status }))\r\n        .then((resp) => {\r\n          if (resp.data.code !== 200) {\r\n            _this.$message.error(\"审核操作失败！\");\r\n          } else {\r\n            _this.$message.success(`审核${statusText}成功！`);\r\n            _this.detailDialogVisible = false;\r\n            _this.getJobList();\r\n          }\r\n        });\r\n    },\r\n    // 批量审核\r\n    async handleBatchAudit(status) {\r\n      if (this.multipleSelection.length === 0) {\r\n        return this.$message.warning('请先选择要审核的招聘信息');\r\n      }\r\n      \r\n      const statusText = status === 1 ? '通过' : '不通过';\r\n      const resp = await this.$confirm(\r\n        `确定要批量审核${statusText}选中的 ${this.multipleSelection.length} 条招聘信息吗？`,\r\n        '提示',\r\n        {\r\n          confirmButtonText: '确定',\r\n          cancelButtonText: '取消',\r\n          type: 'warning',\r\n        }\r\n      ).catch((err) => err);\r\n\r\n      if (resp == \"cancel\") {\r\n        return this.$message.info(\"已取消操作\");\r\n      }\r\n\r\n      const _this = this;\r\n      let successCount = 0;\r\n      let failCount = 0;\r\n      \r\n      axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n      for (const job of this.multipleSelection) {\r\n        try {\r\n          const result = await axios.put(\"job\", JSON.stringify({ id: job.id, status: status }));\r\n          if (result.data.code === 200) {\r\n            successCount++;\r\n          } else {\r\n            failCount++;\r\n          }\r\n        } catch (error) {\r\n          failCount++;\r\n        }\r\n      }\r\n      \r\n      if (failCount === 0) {\r\n        _this.$message.success(`批量审核${statusText}成功！共 ${successCount} 条`);\r\n      } else {\r\n        _this.$message.warning(`批量审核完成！成功 ${successCount} 条，失败 ${failCount} 条`);\r\n      }\r\n      \r\n      _this.getJobList();\r\n    },\r\n    // 显示详情\r\n    showJobDetail(row) {\r\n      this.currentJob = row;\r\n      this.detailDialogVisible = true;\r\n    },\r\n    // 格式化企业名称\r\n    enterpriseFormat(row) {\r\n      const enterprise = this.enterpriseList.find(item => item.id === row.enterpriseId);\r\n      return enterprise ? enterprise.name : \"未知\";\r\n    },\r\n    // 格式化岗位分类\r\n    jobCategoryFormat(row) {\r\n      const category = this.jobCategoryList.find(item => item.id === row.categoryId);\r\n      return category ? category.name : \"未知\";\r\n    },\r\n    // 表格行样式\r\n    tableRowClassName({row, rowIndex}) {\r\n      if (row.status === 2) {\r\n        return 'warning-row';\r\n      } else if (row.status === 3) {\r\n        return 'danger-row';\r\n      }\r\n      return '';\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.board {\r\n  margin-bottom: 20px;\r\n}\r\n.box-card {\r\n  margin: 0 20px;\r\n}\r\n</style>\r\n\r\n<style>\r\n.el-table .warning-row {\r\n  background: #fff7e6;\r\n}\r\n.el-table .danger-row {\r\n  background: #fff1f0;\r\n}\r\n</style>\r\n"]}]}