r\n    <!--卡片视图-->\r\n    <el-card class=\"box-card\">\r\n      <el-row :gutter=\"20\">\r\n        <el-col :span=\"4\">\r\n          <el-input placeholder=\"请输入企业名称\" v-model=\"inputName\" clearable />\r\n        </el-col>\r\n        <el-col :span=\"4\">\r\n          <el-input placeholder=\"请输入企业地址\" v-model=\"inputAddress\" clearable />\r\n        </el-col>\r\n        <el-col :span=\"4\">\r\n          <el-select v-model=\"selectedStatus\" placeholder=\"请选择状态\" clearable>\r\n            <el-option v-for=\"item in statusOptions\" :key=\"item.id\" :label=\"item.name\" :value=\"item.id\"></el-option>\r\n          </el-select>\r\n        </el-col>\r\n        <el-col :span=\"2\">\r\n          <el-button icon=\"el-icon-search\" @click=\"getEnterpriseList\">搜索</el-button>\r\n        </el-col>\r\n        <el-col :span=\"2\">\r\n          <el-button type=\"primary\" @click=\"showAddDialog\"\r\n            style=\"background-color: chocolate;color: aliceblue;\">添加企业</el-button>\r\n        </el-col>\r\n        <el-col :span=\"2\">\r\n          <el-button type=\"danger\" @click=\"multipleDelete\">批量删除</el-button>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <el-table :data=\"enterpriseList\" style=\"width: 100%\" border stripe @selection-change=\"handleSelectionChange\">\r\n        <el-table-column type=\"selection\" width=\"40\"></el-table-column>\r\n        <el-table-column type=\"index\" label=\"#\"></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"企业名称\" ></el-table-column>\r\n        <el-table-column prop=\"scale\" label=\"企业规模\" ></el-table-column>\r\n        <el-table-column prop=\"employeeCount\" label=\"员工数量\" ></el-table-column>\r\n        <el-table-column prop=\"industry\" label=\"所属行业\" ></el-table-column>\r\n        <el-table-column prop=\"address\" label=\"企业地址\" ></el-table-column>\r\n        <el-table-column prop=\"description\" label=\"企业描述\" ></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"状态\" :formatter=\"statusFormat\" ></el-table-column>\r\n        <el-table-column prop=\"createTime\" label=\"创建时间\" ></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"180\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tooltip effect=\"dark\" content=\"修改企业信息\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button type=\"primary\" size=\"mini\" style=\"background-color: chocolate;color: aliceblue;\" @click=\"showEditDialog(scope.row.id)\">修改</el-button>\r\n            </el-tooltip>\r\n            <el-tooltip effect=\"dark\" content=\"删除企业\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button type=\"danger\" icon=\"el-icon-delete\" size=\"mini\" @click=\"deleteEnterpriseById(scope.row.id)\"></el-button>\r\n            </el-tooltip>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <!--分页区域-->\r\n      <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\r\n        :current-page=\"queryInfo.pageNum\" :page-sizes=\"[5, 7, 9]\" :page-size=\"queryInfo.pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\" :total=\"total\">\r\n      </el-pagination>\r\n    </el-card>\r\n\r\n    <!--添加企业对话框-->\r\n    <el-dialog title=\"添加企业\" :visible.sync=\"addDialogVisible\" width=\"60%\" @close=\"addDialogClosed\">\r\n      <!--内容主题区-->\r\n      <el-form :model=\"addForm\" :rules=\"addFormRules\" ref=\"addFormRef\" label-width=\"150px\">\r\n        <el-form-item label=\"企业名称\" prop=\"name\">\r\n          <el-input v-model=\"addForm.name\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"企业规模\" prop=\"scale\">\r\n          <el-input v-model=\"addForm.scale\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"员工数量\" prop=\"employeeCount\">\r\n          <el-input v-model=\"addForm.employeeCount\" type=\"number\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"所属行业\" prop=\"industry\">\r\n          <el-input v-model=\"addForm.industry\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"企业地址\" prop=\"address\">\r\n          <el-input v-model=\"addForm.address\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"企业描述\" prop=\"description\">\r\n          <el-input v-model=\"addForm.description\" type=\"textarea\" rows=\"3\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"状态\" prop=\"status\">\r\n          <el-select v-model=\"addForm.status\" placeholder=\"请选择状态\">\r\n            <el-option v-for=\"item in statusOptions\" :key=\"item.id\" :label=\"item.name\" :value=\"item.id\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n      </el-form>\r\n      <!--底部区域-->\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"addDialogVisible = false\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"addEnterprise\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n\r\n    <!--修改企业对话框-->\r\n    <el-dialog title=\"修改企业信息\" :visible.sync=\"editDialogVisible\" width=\"60%\" @close=\"editDialogClosed\">\r\n      <el-form :model=\"editForm\" :rules=\"editFormRules\" ref=\"editFormRef\" label-width=\"150px\">\r\n        <el-form-item label=\"企业名称\" prop=\"name\">\r\n          <el-input v-model=\"editForm.name\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"企业规模\" prop=\"scale\">\r\n          <el-input v-model=\"editForm.scale\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"员工数量\" prop=\"employeeCount\">\r\n          <el-input v-model=\"editForm.employeeCount\" type=\"number\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"所属行业\" prop=\"industry\">\r\n          <el-input v-model=\"editForm.industry\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"企业地址\" prop=\"address\">\r\n          <el-input v-model=\"editForm.address\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"企业描述\" prop=\"description\">\r\n          <el-input v-model=\"editForm.description\" type=\"textarea\" rows=\"3\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"状态\" prop=\"status\">\r\n          <el-select v-model=\"editForm.status\" placeholder=\"请选择状态\">\r\n            <el-option v-for=\"item in statusOptions\" :key=\"item.id\" :label=\"item.name\" :value=\"item.id\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n      </el-form>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"cancelEdit\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"editEnterprise\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport global from \"@/assets/css/global.css\";\r\nexport default {\r\n  data() {\r\n    return {\r\n      queryInfo: {\r\n        name: \"\",\r\n        address: \"\",\r\n        status: null,\r\n        pageNum: 1,\r\n        pageSize: 7,\r\n      },\r\n      total: 0,\r\n      //控制对话框的显示与隐藏\r\n      addDialogVisible: false,\r\n      //添加企业的表单数据\r\n      addForm: {\r\n        name: \"\",\r\n        logo: \"\",\r\n        scale: \"\",\r\n        employeeCount: null,\r\n        industry: \"\",\r\n        address: \"\",\r\n        description: \"\",\r\n        status: null,\r\n      },\r\n      //验证表单规则对象\r\n      addFormRules: {\r\n        name: [\r\n          { required: true, message: \"请输入企业名称\", trigger: \"blur\" },\r\n        ],\r\n        scale: [\r\n          { required: true, message: \"请输入企业规模\", trigger: \"blur\" },\r\n        ],\r\n        employeeCount: [\r\n          { required: true, message: \"请输入员工数量\", trigger: \"blur\" },\r\n        ],\r\n        industry: [\r\n          { required: true, message: \"请输入所属行业\", trigger: \"blur\" },\r\n        ],\r\n        address: [\r\n          { required: true, message: \"请输入企业地址\", trigger: \"blur\" },\r\n        ],\r\n        status: [\r\n          { required: true, message: \"请选择状态\", trigger: \"change\" },\r\n        ],\r\n      },\r\n      editDialogVisible: false,\r\n      editForm: {},\r\n      editFormRules: {\r\n        name: [\r\n          { required: true, message: \"请输入企业名称\", trigger: \"blur\" },\r\n        ],\r\n        scale: [\r\n          { required: true, message: \"请输入企业规模\", trigger: \"blur\" },\r\n        ],\r\n        employeeCount: [\r\n          { required: true, message: \"请输入员工数量\", trigger: \"blur\" },\r\n        ],\r\n        industry: [\r\n          { required: true, message: \"请输入所属行业\", trigger: \"blur\" },\r\n        ],\r\n        address: [\r\n          { required: true, message: \"请输入企业地址\", trigger: \"blur\" },\r\n        ],\r\n        status: [\r\n          { required: true, message: \"请选择状态\", trigger: \"change\" },\r\n        ],\r\n      },\r\n      inputName: \"\",\r\n      inputAddress: \"\",\r\n      selectedStatus: \"\",\r\n      enterpriseList: [],\r\n      statusOptions: [\r\n        { id: 0, name: \"禁用\" },\r\n        { id: 1, name: \"正常\" },\r\n      ],\r\n      multipleSelection: [],\r\n      dialogImageUrl: \"\",\r\n      dialogVisible: false,\r\n      //添加删除图片 动态绑定图片列表\r\n      pics: [],\r\n      // 发送给后端的JSON图片数组\r\n      pictureList: [],\r\n      picNums: 0,\r\n      deletePicList: [],\r\n    };\r\n  },\r\n  created() {\r\n    this.getEnterpriseList();\r\n  },\r\n  methods: {\r\n    getEnterpriseList() {\r\n      this.queryInfo.name = this.inputName;\r\n      this.queryInfo.address = this.inputAddress;\r\n      // 转换为数字类型，空字符串转换为null\r\n      this.queryInfo.status = this.selectedStatus ? parseInt(this.selectedStatus) : null;\r\n      const _this = this;\r\n      axios.get(\"enterprise\", { params: _this.queryInfo }).then((resp) => {\r\n        _this.enterpriseList = resp.data.data;\r\n        _this.total = resp.data.total;\r\n        _this.queryInfo.pageSize = resp.data.pageSize;\r\n        _this.queryInfo.pageNum = resp.data.pageNum;\r\n      });\r\n    },\r\n    handleSizeChange(newSize) {\r\n      this.queryInfo.pageSize = newSize;\r\n      this.getEnterpriseList();\r\n    },\r\n    handleCurrentChange(newPage) {\r\n      this.queryInfo.pageNum = newPage;\r\n      this.getEnterpriseList();\r\n    },\r\n    showAddDialog() {\r\n      this.addDialogVisible = true;\r\n    },\r\n    // 监听添加对话框的关闭事件\r\n    addDialogClosed() {\r\n      this.$refs.addFormRef.resetFields();\r\n      this.$refs.pictureRef.clearFiles();\r\n      this.pics = [];\r\n      this.pictureList = [];\r\n    },\r\n    // 监听添加按钮\r\n    async addEnterprise() {\r\n      await this.submitFile();\r\n      this.addForm.logo = this.pictureList[0] || '';\r\n      let success = true;\r\n      const _this = this;\r\n      this.$refs.addFormRef.validate(async (valid) => {\r\n        if (!valid) return;\r\n        // 预校验成功，发网络请求\r\n        axios.defaults.headers.post[\"Content-Type\"] = \"application/json\";\r\n        await axios\r\n          .post(\"enterprise\", JSON.stringify(_this.addForm))\r\n          .then((resp) => {\r\n            if (resp.data.code !== 200) {\r\n              this.$message.error(\"添加企业失败！\");\r\n              success = false;\r\n            }\r\n          });\r\n        this.getEnterpriseList();\r\n        if (!success) return;\r\n        //隐藏添加对话框\r\n        this.addDialogVisible = false;\r\n        this.$message.success(\"添加企业成功！\");\r\n      });\r\n    },\r\n    // 显示修改对话框，回显数据\r\n    async showEditDialog(id) {\r\n      const _this = this;\r\n      await axios.get(\"enterprise/\" + id).then((resp) => {\r\n        _this.editForm = resp.data.data;\r\n        // 处理logo显示\r\n        if (_this.editForm.logo) {\r\n          let pic = {};\r\n          pic[\"name\"] = \"\";\r\n          pic[\"url\"] = _this.editForm.logo;\r\n          this.pics.push(pic);\r\n        }\r\n      });\r\n      this.editDialogVisible = true;\r\n    },\r\n    // 监听修改对话框的关闭事件\r\n    editDialogClosed() {\r\n      this.$refs.editFormRef.resetFields();\r\n      this.$refs.pictureEditRef.clearFiles();\r\n      this.pics = [];\r\n      this.pictureList = [];\r\n    },\r\n    // 取消修改\r\n    cancelEdit() {\r\n      this.editDialogVisible = false;\r\n      this.deletePicList.splice(0, this.deletePicList.length);\r\n    },\r\n    async editEnterprise() {\r\n      await this.submitFile();\r\n      if (this.pictureList.length > 0) {\r\n        this.editForm.logo = this.pictureList[0];\r\n      }\r\n      this.$refs.editFormRef.validate(async (valid) => {\r\n        const _this = this;\r\n        if (!valid) return;\r\n        let success = true;\r\n        axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n        await axios\r\n          .put(\"enterprise\", JSON.stringify(_this.editForm))\r\n          .then((resp) => {\r\n            if (resp.data.code !== 200) {\r\n              this.$message.error(\"修改企业信息失败！\");\r\n              success = false;\r\n            }\r\n          });\r\n        if (!success) return;\r\n        this.editDialogVisible = false;\r\n        this.getEnterpriseList();\r\n        this.$message.success(\"修改企业信息成功！\");\r\n      });\r\n    },\r\n    // 监听多选框变化\r\n    handleSelectionChange(val) {\r\n      this.multipleSelection = val;\r\n    },\r\n    async multipleDelete() {\r\n      const _this = this;\r\n      //询问用户是否确认删除\r\n      const resp = await this.$confirm(\r\n        \"此操作将永久删除这些条目, 是否继续?\",\r\n        \"提示\",\r\n        {\r\n          confirmButtonText: \"确定\",\r\n          cancelButtonText: \"取消\",\r\n          type: \"warning\",\r\n        }\r\n      ).catch((err) => err);\r\n\r\n      // 用户确认删除, resp为字符串\"confirm\"\r\n      // 用户取消删除，resp为字符串\"cancel\"\r\n      if (resp == \"cancel\") {\r\n        return _this.$message.info(\"已取消删除\");\r\n      }\r\n\r\n      let ids = [];\r\n      this.multipleSelection.forEach((data) => {\r\n        ids.push(data.id);\r\n      });\r\n      await axios.delete(\"enterprise/\" + ids).then((resp) => {\r\n        if (resp.data.code !== 200) {\r\n          this.$message.error(\"批量删除企业失败！\");\r\n        }\r\n      });\r\n      this.getEnterpriseList();\r\n      this.$message.success(\"批量删除企业成功！\");\r\n    },\r\n    //根据id删除对应的企业\r\n    async deleteEnterpriseById(id) {\r\n      const _this = this;\r\n      //询问用户是否确认删除\r\n      const resp = await this.$confirm(\r\n        \"此操作将永久删除该条目, 是否继续?\",\r\n        \"提示\",\r\n        {\r\n          confirmButtonText: \"确定\",\r\n          cancelButtonText: \"取消\",\r\n          type: \"warning\",\r\n        }\r\n      ).catch((err) => err);\r\n\r\n      // 用户确认删除, resp为字符串\"confirm\"\r\n      // 用户取消删除，resp为字符串\"cancel\"\r\n      if (resp == \"cancel\") {\r\n        return _this.$message.info(\"已取消删除\");\r\n      }\r\n\r\n      await axios.delete(\"enterprise/\" + id).then((resp) => {\r\n        if (resp.data.code !== 200) {\r\n          _this.$message.error(\"删除企业失败！\");\r\n        }\r\n      });\r\n      this.getEnterpriseList();\r\n      this.$message.success(\"删除企业成功！\");\r\n    },\r\n    handleRemove(file) {\r\n      const filePath = file.url;\r\n      const idx = this.pics.findIndex((x) => x.url === filePath);\r\n      if (file.status === \"success\") {\r\n        this.deletePicList.push(file.url);\r\n      }\r\n      this.pics.splice(idx, 1);\r\n    },\r\n    handlePictureCardPreview(file) {\r\n      this.dialogImageUrl = file.url;\r\n      this.dialogVisible = true;\r\n    },\r\n    handleChange(file, filelist) {\r\n      this.pics = filelist.slice(0);\r\n    },\r\n    handleSuccess(response) {\r\n      this.pictureList.push(response.data);\r\n    },\r\n    handleError(err) {\r\n      console.log(err);\r\n    },\r\n    handleExceed() {\r\n      this.$message.error(\"企业logo最多上传一张！\");\r\n    },\r\n    async submitFile() {\r\n      const _this = this;\r\n      for (let i = 0; i < this.pics.length; i++) {\r\n        let formData = new FormData();\r\n        if (this.pics[i].status === \"success\") {\r\n          let s = this.pics[i].url;\r\n          this.pictureList.push(s);\r\n          continue;\r\n        }\r\n        let file = this.pics[i].raw;\r\n        formData.append(\"file\", file);\r\n        await axios.post(\"upload/enterprise\", formData).then((response) => {\r\n          _this.pictureList.push(response.data.data);\r\n        });\r\n      }\r\n    },\r\n    statusFormat(row) {\r\n      if (row.status === 1) {\r\n        return \"正常\";\r\n      } else {\r\n        return \"禁用\";\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.board {\r\n  margin-bottom: 20px;\r\n}\r\n.box-card {\r\n  margin: 0 20px;\r\n}\r\n</style>"]}]}