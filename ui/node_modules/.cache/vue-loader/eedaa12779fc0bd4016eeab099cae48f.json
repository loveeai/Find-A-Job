ait axios.get(\"sysMovie/find/\" + this.actorMovieId).then(response => {\r\n                _this.editCategoryForm = response.data.data.movieCategoryList;\r\n            });\r\n        },\r\n        handleExceed() {\r\n            this.$message.error(\"封面不能超过一张!\");\r\n        },\r\n        async addCategory() {\r\n            const _this = this;\r\n            await axios\r\n                .post(\r\n                    \"sysMovieToCategory/\" +\r\n                    this.actorMovieId +\r\n                    \"/\" +\r\n                    this.selectedMovieCategory\r\n                )\r\n                .then(resp => {\r\n                    console.log(resp);\r\n                });\r\n            axios.get(\"sysMovie/find/\" + this.actorMovieId).then(response => {\r\n                _this.editCategoryForm = response.data.data.movieCategoryList;\r\n            });\r\n        }\r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.row2 {\r\n    margin-top: 20px;\r\n}\r\n</style>"]}]}