AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;;AAGA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Toudi.vue","sourceRoot":"src/views/vaccine","sourcesContent":["<template>\r\n    <div>\r\n        <!--面包屑导航区-->\r\n        <div class=\"board\">\r\n            <el-breadcrumb separator-class=\"el-icon-arrow-right\">\r\n                <el-breadcrumb-item :to=\"{ path: '/welcome' }\">首页</el-breadcrumb-item>\r\n                <el-breadcrumb-item>投递信息管理</el-breadcrumb-item>\r\n                <el-breadcrumb-item>投递信息管理</el-breadcrumb-item>\r\n            </el-breadcrumb>\r\n        </div>\r\n        <el-card class=\"box-card\">\r\n            <el-row :gutter=\"20\" class=\"row2\">\r\n\r\n                <el-col :span=\"5\">\r\n                    <el-input v-model=\"selectedNameCn\" placeholder=\"请输入名称\" clearable></el-input>\r\n                </el-col>\r\n                <el-col :span=\"4\">\r\n                    <el-button icon=\"el-icon-search\" @click=\"getList\">搜索</el-button>\r\n                </el-col>\r\n                <el-col :span=\"2\">\r\n                    <el-button type=\"primary\" style=\"background-color: chocolate;\"\r\n                        @click=\"addDialogVisible = true\">添加</el-button>\r\n                </el-col>\r\n                <el-col :span=\"4\">\r\n                    <el-button type=\"danger\" @click=\"multipleDelete\" v-if=\"roleId == 1\">批量删除</el-button>\r\n                </el-col>\r\n            </el-row>\r\n\r\n            <!--    列表字段-->\r\n            <el-table :data=\"volunteerList\" style=\"width: 100%\" border stripe @selection-change=\"handleSelectionChange\">\r\n                <el-table-column type=\"selection\" width=\"55\"></el-table-column>\r\n                <el-table-column type=\"index\" label=\"#\"></el-table-column>\r\n                <el-table-column prop=\"sysUser.userName\" label=\"投递用户\"></el-table-column>\r\n                <el-table-column prop=\"job.name\" label=\"招聘信息\"></el-table-column>\r\n                <el-table-column prop=\"company.name\" label=\"投递公司\"></el-table-column>\r\n                <el-table-column prop=\"job.category.name\" label=\"投递岗位\"></el-table-column>\r\n                <el-table-column prop=\"times\" label=\"投递时间\"></el-table-column>\r\n                <!--      操作按钮-->\r\n                <el-table-column label=\"操作\" width=\"400\">\r\n                    <template slot-scope=\"scope\">\r\n                        <el-tooltip effect=\"dark\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n                            <el-button type=\"success\" size=\"mini\" @click=\"addMianshiDialog(scope.row)\">\r\n                                邀约面试\r\n                            </el-button>\r\n                        </el-tooltip>\r\n                        <el-tooltip effect=\"dark\" content=\"论文下载\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n                            <el-button type=\"primary\" style=\"background-color: chocolate;\" size=\"mini\"\r\n                                @click=\"download(scope.row.sysUser.fileUrl)\">下载简历\r\n                            </el-button>\r\n                        </el-tooltip>\r\n                        <el-tooltip effect=\"dark\" content=\"删除信息\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\"\r\n                            v-if=\"roleId == 1\">\r\n                            <el-button type=\"danger\" icon=\"el-icon-delete\" size=\"mini\"\r\n                                @click=\"deleteMovieById(scope.row.id)\">\r\n                            </el-button>\r\n                        </el-tooltip>\r\n                    </template>\r\n                </el-table-column>\r\n            </el-table>\r\n\r\n            <!--分页区域-->\r\n            <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\r\n                :current-page=\"queryInfo.pageNum\" :page-sizes=\"[5, 7, 9]\" :page-size=\"queryInfo.pageSize\"\r\n                layout=\"total, sizes, prev, pager, next, jumper\" :total=\"total\"></el-pagination>\r\n        </el-card>\r\n\r\n        <!--添加对话框-->\r\n        <el-dialog title=\"添加\" :visible.sync=\"addDialogVisible\" width=\"60%\" @close=\"addDialogClosed\">\r\n            <!--内容主题区-->\r\n            <el-form :model=\"addForm\" :rules=\"addFormRules\" ref=\"addFormRef\" label-width=\"100px\">\r\n                <!--prop：在addFormRules中定义校验规则， v-model：双向绑定数据-->\r\n                <el-form-item label=\"面试时间\" prop=\"times\">\r\n                    <el-date-picker v-model=\"addForm.times\" value-format=\"yyyy-MM-dd HH:mm:ss\" type=\"datetime\"\r\n                        placeholder=\"选择日期\">\r\n                    </el-date-picker>\r\n                </el-form-item>\r\n\r\n            </el-form>\r\n            <!--底部区域-->\r\n            <span slot=\"footer\" class=\"dialog-footer\">\r\n                <el-button @click=\"addDialogVisible = false\">取 消</el-button>\r\n                <el-button type=\"primary\" @click=\"add\">确 定</el-button>\r\n            </span>\r\n        </el-dialog>\r\n\r\n        <!-- 修改信息对话框 -->\r\n        <el-dialog title=\"修改信息\" :visible.sync=\"editDialogVisible\" width=\"60%\" @close=\"editDialogClosed\">\r\n            <el-form :model=\"editForm\" :rules=\"editFormRules\" ref=\"editFormRef\" label-width=\"100px\">\r\n                <el-form-item label=\"成果名称\" prop=\"name\">\r\n                    <el-input v-model=\"editForm.name\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"简介\" prop=\"content\">\r\n                    <el-input v-model=\"editForm.content\"></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"上传文件\">\r\n                    <el-upload class=\"upload-demo\" action=\"http://127.0.0.1:8181/upload/movie\"\r\n                        :on-change=\"handleChange2\" :file-list=\"fileList2\" :http-request=\"submitFile2\">\r\n                        <el-button size=\"small\" type=\"primary\">上传文件</el-button>\r\n                        <div slot=\"tip\" class=\"el-upload__tip\">上传新文件将自动覆盖旧文件</div>\r\n                    </el-upload>\r\n                    <el-dialog :visible.sync=\"dialogVisible\">\r\n                        <img width=\"100%\" :src=\"dialogImageUrl\" alt />\r\n                    </el-dialog>\r\n                </el-form-item>\r\n            </el-form>\r\n            <span slot=\"footer\" class=\"dialog-footer\">\r\n                <el-button @click=\"editDialogVisible = false\">取 消</el-button>\r\n                <el-button type=\"primary\" @click=\"editHallInfo\">确 定</el-button>\r\n            </span>\r\n        </el-dialog>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    data() {\r\n        return {\r\n            roleId: '',\r\n            isList: [{ name: '是' }, { name: '否' }],\r\n            queryInfo: {\r\n                selectedNameCn: \"\",\r\n                pageNum: 1,\r\n                pageSize: 7,\r\n                startDate: \"\",\r\n                endDate: \"\"\r\n            },\r\n            total: 0,\r\n            url: \"http://localhost:8182/\",\r\n            //控制对话框的显示与隐藏\r\n            addDialogVisible: false,\r\n            selectedDate: [],\r\n            selectedNameCn: \"\",\r\n            categoryList: [],\r\n            volunteerList: [],\r\n            editForm: {},\r\n            editActorForm: null,\r\n            editCategoryForm: [],\r\n            editDialogVisible: false,\r\n            editActorVisible: false,\r\n            multipleSelection: [],\r\n            dialogVisible: false,\r\n            dialogImageUrl: \"\",\r\n            disabled: false,\r\n            //封面增删变量\r\n            poster: [],\r\n            //发送给后端的JSON图片\r\n            posterL: [],\r\n            deletePostList: [],\r\n            //添加删除图片集 动态绑定图片列表\r\n            pics: [],\r\n            // 发送给后端的JSON图片数组\r\n            pictureList: [],\r\n            picNums: 0,\r\n            deletePicList: [],\r\n            //添加表单数据\r\n            addForm: {\r\n                posters: \"\",\r\n            },\r\n            fileUrl: \"\",\r\n            //添加验证表单规则对象\r\n            addFormRules: {\r\n                times: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n            },\r\n            fileList2: [],\r\n            //修改验证表单规则对象\r\n            editFormRules: {\r\n                name: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n                content: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n            }\r\n        };\r\n    },\r\n    created() {\r\n        this.roleId = JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser.roleId\r\n        this.getList();\r\n    },\r\n    methods: {\r\n        download(fileUrl) {\r\n            window.open('http://localhost:8182/' + fileUrl)\r\n        },\r\n        getList() {\r\n            this.queryInfo.name = this.selectedNameCn;\r\n            if (!this.selectedDate) {\r\n                this.queryInfo.startDate = this.selectedDate[0];\r\n                this.queryInfo.endDate = this.selectedDate[1];\r\n            }\r\n            const _this = this;\r\n            axios.get(\"toudi\", { params: _this.queryInfo }).then(resp => {\r\n                console.log(resp);\r\n                _this.volunteerList = resp.data.data;\r\n                _this.total = resp.data.total;\r\n                _this.queryInfo.pageSize = resp.data.pageSize;\r\n                _this.queryInfo.pageNum = resp.data.pageNum;\r\n            });\r\n        },\r\n        addMianshiDialog(row) {\r\n            this.toudiData = row\r\n            this.addDialogVisible = true;\r\n        },\r\n\r\n        ifShow(id) {\r\n            let i = 0;\r\n            let l = true;\r\n            for (i = 0; i < this.editCategoryForm.length; i++) {\r\n                if (id == this.editCategoryForm[i].movieCategoryId) {\r\n                    l = false;\r\n                }\r\n            }\r\n            return l;\r\n        },\r\n        handleSizeChange(newSize) {\r\n            this.queryInfo.pageSize = newSize;\r\n            this.getList();\r\n            console.log(newSize);\r\n        },\r\n        handleChange2(file, fileList2) {\r\n            this.fileList2 = fileList2.slice(-1);\r\n            this.fileName = file.name\r\n        },\r\n\r\n        async submitFile2() {\r\n            const _this = this;\r\n            for (let i = 0; i < this.fileList2.length; i++) {\r\n                let formData = new FormData();\r\n                let file2 = this.fileList2[i].raw;\r\n                formData.append(\"file\", file2);\r\n                this.fileName = file2.name;\r\n                await axios.post(\"upload/movie\", formData).then((response) => {\r\n                    this.fileUrl = response.data.data;\r\n                });\r\n            }\r\n        },\r\n        handleCurrentChange(newPage) {\r\n            this.queryInfo.pageNum = newPage;\r\n            this.getList();\r\n            console.log(newPage);\r\n        },\r\n        async submitFile() {\r\n            const _this = this;\r\n            for (let i = 0; i < this.pics.length; i++) {\r\n                let formData = new FormData();\r\n                if (this.pics[i].status === \"success\") {\r\n                    let s = this.pics[i].url;\r\n                    this.pictureList.push(s.substring(s.indexOf(\"/images\")));\r\n                    continue;\r\n                }\r\n                let file = this.pics[i].raw;\r\n                formData.append(\"file\", file);\r\n                await axios.post(\"upload/movie\", formData).then(response => {\r\n                    _this.pictureList.push(response.data.data);\r\n                });\r\n            }\r\n        },\r\n        async submitFileP() {\r\n            const _this = this;\r\n            for (let i = 0; i < this.poster.length; i++) {\r\n                let formData = new FormData();\r\n                if (this.poster[i].status === \"success\") {\r\n                    let s = this.poster[i].url;\r\n                    this.posterL.push(s.substring(s.indexOf(\"/images\")));\r\n                    continue;\r\n                }\r\n                let file = this.poster[i].raw;\r\n                formData.append(\"file\", file);\r\n                await axios.post(\"upload/movie\", formData).then(response => {\r\n                    _this.posterL.push(response.data.data);\r\n                });\r\n            }\r\n        },\r\n        // 监听添加对话框的关闭事件\r\n        addDialogClosed() {\r\n            this.fileList2 = [],\r\n                this.fileUrl = '',\r\n                this.$refs.addFormRef.resetFields();\r\n            // this.$refs.pictureRef.clearFiles();\r\n            // this.$refs.posterRef.clearFiles();\r\n\r\n            this.poster = [];\r\n            this.posterL = [];\r\n            this.pics = [];\r\n            this.pictureList = [];\r\n        },\r\n        // 监听添加按钮\r\n        async add() {\r\n            this.addForm.userId = this.toudiData.userId\r\n            this.addForm.jobId = this.toudiData.jobId\r\n            this.addForm.companyId = this.toudiData.companyId\r\n            this.addForm.status = '待接受'\r\n            const _this = this;\r\n            this.$refs.addFormRef.validate(async valid => {\r\n                console.log(valid);\r\n                if (!valid) return;\r\n                //预校验成功，发网络请求\r\n                axios.defaults.headers.post[\"Content-Type\"] = \"application/json\";\r\n                await axios\r\n                    .post(\"interview\", JSON.stringify(_this.addForm))\r\n                    .then(resp => {\r\n                        console.log(resp);\r\n                        if (resp.data.code !== 200) {\r\n                            this.$message.error(\"邀请面试失败！\");\r\n                        }\r\n                    });\r\n                //隐藏添加对话框\r\n                this.addDialogVisible = false;\r\n                //重新加载列表\r\n                this.getList();\r\n                this.$message.success(\"邀请面试成功！\");\r\n            });\r\n        },\r\n        // 监听修改对话框的关闭事件\r\n        editDialogClosed() {\r\n            this.$refs.editFormRef.resetFields();\r\n            // this.$refs.pictureEditRef.clearFiles();\r\n            this.$refs.posterEditRef.clearFiles();\r\n            this.pics = [];\r\n            this.pictureList = [];\r\n            this.posterL = [];\r\n            this.poster = [];\r\n        },\r\n\r\n\r\n        async agreen(id) {\r\n            this.editForm.id = id\r\n            this.editForm.status = '通过'\r\n            const _this = this;\r\n            axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n            await axios\r\n                .put(\"toudi\", JSON.stringify(_this.editForm))\r\n                .then(resp => {\r\n                    if (resp.data.code !== 200) {\r\n                        this.$message.error(\"审核信息失败！\");\r\n                        success = false;\r\n                    }\r\n                });\r\n\r\n            this.editDialogVisible = false;\r\n            this.getList();\r\n            this.$message.success(\"审核信息成功！\");\r\n        },\r\n\r\n        async jujue(id) {\r\n            this.editForm.id = id\r\n            this.editForm.status = '未通过'\r\n            const _this = this;\r\n            axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n            await axios\r\n                .put(\"toudi\", JSON.stringify(_this.editForm))\r\n                .then(resp => {\r\n                    if (resp.data.code !== 200) {\r\n                        this.$message.error(\"审核信息失败！\");\r\n                        success = false;\r\n                    }\r\n                });\r\n\r\n            this.editDialogVisible = false;\r\n            this.getList();\r\n            this.$message.success(\"审核信息成功！\");\r\n\r\n        },\r\n\r\n        // 修改信息对话框\r\n        async editHallInfo() {\r\n            await this.submitFile();\r\n            this.editForm.pictures = JSON.stringify(this.pictureList);\r\n            await this.submitFileP();\r\n            this.editForm.posters = JSON.stringify(this.posterL);\r\n            this.editForm.uuserId = JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser.userId;\r\n            this.$refs.editFormRef.validate(async valid => {\r\n                const _this = this;\r\n                if (!valid) return;\r\n                let success = true;\r\n                axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n                await axios\r\n                    .put(\"toudi\", JSON.stringify(_this.editForm))\r\n                    .then(resp => {\r\n                        if (resp.data.code !== 200) {\r\n                            this.$message.error(\"修改信息失败！\");\r\n                            success = false;\r\n                        }\r\n                    });\r\n                if (!success) return;\r\n                for (let s of this.deletePicList) {\r\n                    await axios.get(\r\n                        \"/upload/delete?filePath=\" + s.substring(s.indexOf(\"/images\"))\r\n                    );\r\n                }\r\n                for (let s of this.deletePostList) {\r\n                    await axios.get(\r\n                        \"/upload/delete?filePath=\" + s.substring(s.indexOf(\"/images\"))\r\n                    );\r\n                }\r\n                this.editDialogVisible = false;\r\n                this.getList();\r\n                this.$message.success(\"修改信息成功！\");\r\n            });\r\n        },\r\n        handleChangeP(file, filelist) {\r\n            this.poster = filelist;\r\n            console.log(this.poster);\r\n        },\r\n        handleSuccessP(response) {\r\n            this.posterL.push(response.data);\r\n            this.addForm = JSON.stringify(this.posterL);\r\n            this.editForm = JSON.stringify(this.posterL);\r\n        },\r\n        handlePictureCardPreviewP(file) {\r\n            this.dialogImageUrl = file.url;\r\n            this.dialogVisible = true;\r\n        },\r\n        handleRemoveP(file) {\r\n            const filePath = file.url;\r\n            console.log(filePath);\r\n            const idx = this.poster.findIndex(x => x.url === filePath);\r\n            if (file.status === \"success\") {\r\n                this.deletePostList.push(file.url);\r\n            }\r\n            this.poster.splice(idx, 1);\r\n        },\r\n        handleError(err) {\r\n            console.log(err);\r\n        },\r\n        // 显示修改对话框，回显数据\r\n        async showEditDialog(id1) {\r\n            console.log(id1)\r\n            const _this = this;\r\n            await axios.get(\"toudi/\" + id1).then(resp => {\r\n                console.log(resp);\r\n             