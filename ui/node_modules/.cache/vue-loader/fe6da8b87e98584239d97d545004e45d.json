{"remainingRequest":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\bishe\\springboot+vue\\job\\study\\ui\\src\\views\\vaccine\\Category.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\src\\views\\vaccine\\Category.vue","mtime":1745000026456},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Category.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4EA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Category.vue","sourceRoot":"src/views/vaccine","sourcesContent":["<template>\r\n  <div>\r\n    <!--面包屑导航区域-->\r\n    <div class=\"board\">\r\n      <el-breadcrumb separator-class=\"el-icon-arrow-right\">\r\n        <el-breadcrumb-item :to=\"{ path: '/welcome' }\">首页</el-breadcrumb-item>\r\n        <el-breadcrumb-item>岗位信息管理</el-breadcrumb-item>\r\n        <el-breadcrumb-item>岗位信息管理</el-breadcrumb-item>\r\n      </el-breadcrumb>\r\n    </div>\r\n\r\n    <!--卡片视图-->\r\n    <el-card class=\"box-card\">\r\n      <el-row :gutter=\"20\">\r\n        <el-col :span=\"2\">\r\n          <el-button type=\"primary\" @click=\"addDialogVisible = true\" icon=\"el-icon-plus\">添加</el-button>\r\n        </el-col>\r\n        <el-col :span=\"2\">\r\n          <el-button type=\"danger\" @click=\"multipleDelete\">批量删除</el-button>\r\n        </el-col>\r\n      </el-row>\r\n\r\n      <!--岗位列表-->\r\n      <el-table :data=\"titlelist\" style=\"width: 90%\" border stripe @selection-change=\"handleSelectionChange\">\r\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\r\n        <el-table-column type=\"index\" label=\"#\"></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"岗位名称\" width=\"180\"></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"150\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tooltip effect=\"dark\" content=\"修改岗位\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button size=\"mini\" @click=\"showEditDialog(scope.row.id)\">编辑</el-button>\r\n            </el-tooltip>\r\n            <el-tooltip effect=\"dark\" content=\"删除岗位\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button type=\"danger\" size=\"mini\" @click=\"deleteMovieAgeById(scope.row.id)\">删除</el-button>\r\n            </el-tooltip>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <!--分页区域-->\r\n      <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\r\n        :current-page=\"queryInfo.pageNum\" :page-sizes=\"[5, 7, 9]\" :page-size=\"queryInfo.pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\" :total=\"total\"></el-pagination>\r\n    </el-card>\r\n\r\n    <!--添加对话框-->\r\n    <el-dialog title=\"新增岗位\" :visible.sync=\"addDialogVisible\" width=\"50%\" @close=\"addDialogClosed\">\r\n      <!--内容主题区-->\r\n      <el-form :model=\"addForm\" :rules=\"addFormRules\" ref=\"addFormRef\" label-width=\"120px\">\r\n        <el-form-item label=\"岗位名称\" prop=\"name\">\r\n          <el-input v-model=\"addForm.name\"></el-input>\r\n        </el-form-item>\r\n      </el-form>\r\n      <!--底部区域-->\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"addDialogVisible = false\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"add\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n\r\n    <!--修改对话框-->\r\n    <el-dialog title=\"修改岗位\" :visible.sync=\"editDialogVisible\" width=\"50%\" @close=\"editDialogClosed\">\r\n      <el-form :model=\"editForm\" :rules=\"editFormRules\" ref=\"editFormRef\" label-width=\"120px\">\r\n        <el-form-item label=\"岗位名称\" prop=\"name\">\r\n          <el-input v-model=\"editForm.name\"></el-input>\r\n        </el-form-item>\r\n      </el-form>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"editDialogVisible = false\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"editMovieAgeInfo\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"titlelist\",\r\n  // this.$message和this.$confirm都属于原型挂载, 在element.js中配置\r\n  // Vue.prototype.$message = Message\r\n  // Vue.prototype.$confirm = MessageBox.confirm\r\n  data() {\r\n    return {\r\n      queryInfo: {\r\n        query: \"\",\r\n        pageNum: 1,\r\n        pageSize: 7\r\n      },\r\n      titlelist: [],\r\n      total: 0,\r\n      //控制对话框的显示与隐藏\r\n      addDialogVisible: false,\r\n      //添加的表单数据\r\n      addForm: {\r\n        // movieAgeName: ''\r\n        // name: '',\r\n      },\r\n      //验证表单规则对象\r\n      addFormRules: {\r\n        name: [{ required: true, message: \"请输入岗位名称\", trigger: \"blur\" }]\r\n      },\r\n      editDialogVisible: false,\r\n      editForm: {},\r\n      editFormRules: {\r\n        name: [{ required: true, message: \"请输入岗位名称\", trigger: \"blur\" }]\r\n      },\r\n      multipleSelection: []\r\n    };\r\n  },\r\n  created() {\r\n    this.getList();\r\n  },\r\n  methods: {\r\n    getList() {\r\n      const _this = this;\r\n      axios.get(\"category\", { params: _this.queryInfo }).then(resp => {\r\n        _this.titlelist = resp.data.data;\r\n        _this.total = resp.data.total;\r\n        _this.queryInfo.pageSize = resp.data.pageSize;\r\n        _this.queryInfo.pageNum = resp.data.pageNum;\r\n      });\r\n    },\r\n    handleSizeChange(newSize) {\r\n      this.queryInfo.pageSize = newSize;\r\n      this.getList();\r\n    },\r\n    handleCurrentChange(newPage) {\r\n      this.queryInfo.pageNum = newPage;\r\n      this.getList();\r\n    },\r\n    // 监听添加对话框的关闭事件\r\n    addDialogClosed() {\r\n      this.$refs.addFormRef.resetFields();\r\n    },\r\n    // 监听添加按钮\r\n    add() {\r\n      const _this = this;\r\n      this.$refs.addFormRef.validate(async valid => {\r\n        console.log(valid);\r\n        if (!valid) return;\r\n        //预校验成功，发网络请求\r\n        axios.defaults.headers.post[\"Content-Type\"] = \"application/json\";\r\n        // _this.addForm.empId = res.userId;\r\n        await axios\r\n          .post(\"category\", JSON.stringify(_this.addForm))\r\n          .then(resp => {\r\n            console.log(resp);\r\n            if (resp.data.code !== 200) {\r\n              this.$message.error(resp.data.msg);\r\n            } else {\r\n              //隐藏添加对话框\r\n              this.addDialogVisible = false;\r\n              //重新加载列表\r\n              this.getList();\r\n              this.$message.success(\"添加岗位成功！\");\r\n            }\r\n          });\r\n      });\r\n    },\r\n    // 显示修改对话框，回显数据\r\n    showEditDialog(id) {\r\n      const _this = this;\r\n      axios.get(\"category/\" + id).then(resp => {\r\n        console.log(resp);\r\n        _this.editForm = resp.data.data;\r\n      });\r\n      this.editDialogVisible = true;\r\n    },\r\n    // 监听修改对话框的关闭事件\r\n    editDialogClosed() {\r\n      this.$refs.editFormRef.resetFields();\r\n    },\r\n    // 修改岗位信息并提交\r\n    editMovieAgeInfo() {\r\n      this.$refs.editFormRef.validate(async valid => {\r\n        const _this = this;\r\n        if (!valid) return;\r\n        axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n        await axios\r\n          .put(\"/category\", JSON.stringify(_this.editForm))\r\n          .then(resp => {\r\n            if (resp.data.code != 200) {\r\n              this.$message.error(\"岗位修改失败！\");\r\n            }\r\n            this.$message.success(\"岗位修改成功\");\r\n          });\r\n        this.editDialogVisible = false;\r\n        this.getList();\r\n      });\r\n    },\r\n    // 监听多选框变化\r\n    handleSelectionChange(val) {\r\n      this.multipleSelection = val;\r\n    },\r\n    async multipleDelete() {\r\n      const _this = this;\r\n      //询问用户是否确认删除\r\n      const resp = await this.$confirm(\r\n        \"此操作将永久删除这些条目, 是否继续?\",\r\n        \"提示\",\r\n        {\r\n          confirmButtonText: \"确定\",\r\n          cancelButtonText: \"取消\",\r\n          type: \"warning\"\r\n        }\r\n      ).catch(err => err);\r\n\r\n      // 用户确认删除, resp为字符串\"confirm\"\r\n      // 用户取消删除，resp为字符串\"cancel\"\r\n      if (resp == \"cancel\") {\r\n        return _this.$message.info(\"已取消删除\");\r\n      }\r\n\r\n      let ids = [];\r\n      this.multipleSelection.forEach(data => {\r\n        ids.push(data.id);\r\n      });\r\n      await axios.delete(\"category/\" + ids).then(resp => {\r\n        if (resp.data.code !== 200) {\r\n          this.$message.success(\"批量删除失败！\");\r\n        }\r\n      });\r\n      this.getList();\r\n      this.$message.success(\"批量删除成功！\");\r\n    },\r\n    //根据id删除对应的岗位\r\n    async deleteMovieAgeById(id) {\r\n      const _this = this;\r\n      //询问用户是否确认删除\r\n      const resp = await this.$confirm(\r\n        \"此操作将永久删除该条目, 是否继续?\",\r\n        \"提示\",\r\n        {\r\n          confirmButtonText: \"确定\",\r\n          cancelButtonText: \"取消\",\r\n          type: \"warning\"\r\n        }\r\n      ).catch(err => err);\r\n\r\n      // 用户确认删除, resp为字符串\"confirm\"\r\n      // 用户取消删除，resp为字符串\"cancel\"\r\n      console.log(resp);\r\n      if (resp == \"cancel\") {\r\n        return _this.$message.info(\"已取消删除\");\r\n      }\r\n\r\n      await axios.delete(\"category/\" + id).then(resp => {\r\n        if (resp.data.code !== 200) {\r\n          console.log(resp);\r\n          _this.$message.error(resp.data.msg);\r\n        } else {\r\n          this.getList();\r\n          this.$message.success(\"删除岗位成功！\");\r\n        }\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped></style>"]}]}