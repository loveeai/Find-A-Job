{"remainingRequest":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\bishe\\springboot+vue\\job\\study\\ui\\src\\views\\vaccine\\Statistics.vue?vue&type=script&lang=js&","dependencies":[{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\src\\views\\vaccine\\Statistics.vue","mtime":1744630891170},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\bishe\\springboot+vue\\job\\study\\ui\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Statistics.vue"],"names":[],"mappings":";;;;;;;;;AASA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;;AAGA","file":"Statistics.vue","sourceRoot":"src/views/vaccine","sourcesContent":["<template>\r\n    <div class=\"chart-container\">\r\n        <div id=\"chartPie\" style=\"width:700px; height:550px;\"></div>\r\n        <div id=\"myChart\" style=\"width:700px; height:550px;\"></div>\r\n    </div>\r\n\r\n</template>\r\n\r\n<script>\r\nimport * as echarts from \"echarts\";\r\nexport default {\r\n    name: \"FilmChart2\",\r\n    data() {\r\n        return {\r\n            // 定义图表，各种参数\r\n            msg: \"柱状图\",\r\n            datay: [],\r\n            datax: [],\r\n            //扇形图\r\n            chartPie: '',\r\n            myChart: '',\r\n            typeName: [],\r\n            typeNum: []\r\n        }\r\n    },\r\n\r\n    watch: {\r\n    datay: {\r\n      //对于深层对象的属性，watch不可达，因此对数组监控需要将数组先清空，再添加数据\r\n      handler: function () {\r\n        this.drawLine();\r\n      },\r\n      deep: true,\r\n    },\r\n    datax:{\r\n      handler: function(){\r\n        this.drawLine();\r\n      },\r\n      deep: true,\r\n    }\r\n  },\r\n\r\n    methods: {\r\n        drawLine(){\r\n            this.myChart = echarts.init(document.getElementById(\"myChart\"));\r\n            //2、构造图表数据\r\n            this.myChart.setOption({\r\n                title: {\r\n                    text: \"各设备借用人数统计x设备，y借用人数\",\r\n                    left: \"center\",\r\n                    tooltip: {},\r\n                },\r\n                xAxis: {\r\n                    data: this.datax,\r\n                },\r\n                yAxis: {},\r\n                series: [\r\n                    {\r\n                        name: \"年龄\",\r\n                        data: this.datay,\r\n                        type: \"bar\",\r\n                        itemStyle: {\r\n                            normal: {\r\n                                label: {\r\n                                    show: true,\r\n                                    position: 'top',\r\n                                    textStyle: {\r\n                                        color: 'black',\r\n                                        fontSize: 10\r\n                                    }\r\n                                }\r\n                            }\r\n                        }\r\n                    },\r\n                ],\r\n            })\r\n        },\r\n        drawPieChart() {\r\n            this.chartPie = echarts.init(document.getElementById(\"chartPie\"));\r\n            this.chartPie.setOption({\r\n                //设置标题,副标题,以及标题位置居中\r\n                title: {\r\n                    text: '各实验室室预约情况统计',\r\n                    x: 'center'\r\n                },\r\n                //具体点击某一项触发的样式内容\r\n                tooltip: {\r\n                    trigger: 'item',\r\n                    formatter: \"{a} <br/>{b} : {c} ({d}%)\"\r\n                },\r\n                //左上侧分类条形符\r\n                legend: {\r\n                    orient: 'vertical',\r\n                    left: 'left',\r\n                    data: []\r\n                },\r\n                //饼状图类型以及数据源\r\n                series: [\r\n                    {\r\n                        name: '统计数量',\r\n                        type: 'pie',\r\n                        radius: '70%',\r\n                        center: ['50%', '60%'],\r\n                        data: [],\r\n                        //设置饼状图扇形区域的样式\r\n                        itemStyle: {\r\n                            emphasis: {\r\n                                shadowBlur: 10,\r\n                                shadowOffsetX: 0,\r\n                                shadowColor: 'rgba(0, 0, 0, 1)'\r\n                            }\r\n                        },\r\n                    }\r\n                ]\r\n            });\r\n            // 1、基于准备好的dom，初始化echarts实例\r\n\r\n        },\r\n        //动态获取饼状图的数据\r\n        async initData() {\r\n            var res = await this.axios.get(\"statistics\");\r\n            var getData = [];\r\n            //先进行赋值\r\n            for (let i = 0; i < res.data.data.length; i++) {\r\n                var obj = new Object();\r\n                obj.name = res.data.data[i].name;\r\n                obj.value = res.data.data[i].nums;\r\n                getData[i] = obj;\r\n            }\r\n            this.chartPie.setOption({\r\n                legend: {\r\n                    data: res.data.name,\r\n                },\r\n                series: [{\r\n                    data: getData,\r\n                }]\r\n            });\r\n            var response = await axios.get('getStatistics');\r\n            this.datay.length = 0;\r\n            for (let i = 0; i < response.data.data.length; i++) {\r\n                this.datax.push(response.data.data[i].name);\r\n                this.datay.push(response.data.data[i].nums);\r\n\r\n            }\r\n            console.log(this.datay)\r\n            console.log(this.datax)\r\n\r\n        },\r\n\r\n        drawCharts() {\r\n            this.drawPieChart();\r\n        },\r\n\r\n    },\r\n    mounted() {\r\n        this.initData();\r\n        this.drawCharts();\r\n    },\r\n\r\n    // created() {\r\n    //     axios.get('getStatistics').then(response => {\r\n    //         this.datay.length = 0;\r\n    //         for (let i = 0; i < response.data.data.length; i++) {\r\n    //             this.datay.push(response.data.data[i].num);\r\n    //             this.datax.push(response.data.data[i].name);\r\n    //         }\r\n    //     })\r\n    // },\r\n\r\n\r\n}\r\n\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    width: 100%;\r\n    float: left;\r\n    background-color: whitesmoke;\r\n}\r\n</style>"]}]}