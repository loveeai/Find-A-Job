{"remainingRequest":"C:\\Users\\hjj\\Desktop\\study\\ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\hjj\\Desktop\\study\\ui\\src\\views\\vaccine\\CommentInfo.vue?vue&type=script&lang=js&","dependencies":[{"path":"C:\\Users\\hjj\\Desktop\\study\\ui\\src\\views\\vaccine\\CommentInfo.vue","mtime":1774683833681},{"path":"C:\\Users\\hjj\\Desktop\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\hjj\\Desktop\\study\\ui\\node_modules\\babel-loader\\lib\\index.js","mtime":315532800000},{"path":"C:\\Users\\hjj\\Desktop\\study\\ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"C:\\Users\\hjj\\Desktop\\study\\ui\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["CommentInfo.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA0DA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"CommentInfo.vue","sourceRoot":"src/views/vaccine","sourcesContent":["<template>\n  <div>\n    <div class=\"board\">\n      <el-breadcrumb separator-class=\"el-icon-arrow-right\">\n        <el-breadcrumb-item :to=\"{ path: '/welcome' }\">首页</el-breadcrumb-item>\n        <el-breadcrumb-item>招聘管理</el-breadcrumb-item>\n        <el-breadcrumb-item>评论管理</el-breadcrumb-item>\n      </el-breadcrumb>\n    </div>\n\n    <el-card class=\"box-card\">\n      <el-row :gutter=\"20\">\n        <el-col :span=\"4\">\n          <el-input placeholder=\"职位ID\" v-model=\"inputJobId\" clearable />\n        </el-col>\n        <el-col :span=\"5\">\n          <el-input placeholder=\"用户昵称\" v-model=\"inputUserName\" clearable />\n        </el-col>\n        <el-col :span=\"7\">\n          <el-input placeholder=\"评论内容\" v-model=\"inputContent\" clearable />\n        </el-col>\n        <el-col :span=\"2\">\n          <el-button icon=\"el-icon-search\" @click=\"getCommentList\">搜索</el-button>\n        </el-col>\n      </el-row>\n\n      <el-table :data=\"commentList\" style=\"width: 100%\" border stripe>\n        <el-table-column type=\"index\" :index=\"getTableIndex\" label=\"\"></el-table-column>\n        <el-table-column prop=\"id\" label=\"评论ID\" width=\"100\"></el-table-column>\n        <el-table-column prop=\"jobId\" label=\"职位ID\" width=\"100\"></el-table-column>\n        <el-table-column prop=\"jobTitle\" label=\"职位标题\" min-width=\"160\"></el-table-column>\n        <el-table-column prop=\"userName\" label=\"用户\" width=\"140\"></el-table-column>\n        <el-table-column prop=\"content\" label=\"内容\" min-width=\"220\"></el-table-column>\n        <el-table-column prop=\"times\" label=\"时间\" width=\"160\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-tooltip effect=\"dark\" content=\"删除评论\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\n              <el-button type=\"danger\" icon=\"el-icon-delete\" size=\"mini\" @click=\"deleteCommentById(scope.row.id)\"></el-button>\n            </el-tooltip>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <el-pagination\n        @size-change=\"handleSizeChange\"\n        @current-change=\"handleCurrentChange\"\n        :current-page=\"queryInfo.pageNum\"\n        :page-sizes=\"[5, 7, 10]\"\n        :page-size=\"queryInfo.pageSize\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        :total=\"total\"\n      >\n      </el-pagination>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport global from \"@/assets/css/global.css\";\nexport default {\n  data() {\n    return {\n      queryInfo: {\n        jobId: null,\n        userName: \"\",\n        content: \"\",\n        pageNum: 1,\n        pageSize: 7,\n      },\n      inputJobId: \"\",\n      inputUserName: \"\",\n      inputContent: \"\",\n      total: 0,\n      commentList: [],\n      roleId: null,\n    };\n  },\n  created() {\n    const loginUser = JSON.parse(sessionStorage.getItem(\"loginUser\") || \"{}\");\n    this.roleId = loginUser?.sysUser?.roleId;\n    this.getCommentList();\n  },\n  methods: {\n    getTableIndex(index) {\n      return (Number(this.queryInfo.pageNum || 1) - 1) * Number(this.queryInfo.pageSize || 0) + index + 1;\n    },\n    getCommentList() {\n      const jobIdNumber = Number(this.inputJobId);\n      this.queryInfo.jobId = this.inputJobId && !Number.isNaN(jobIdNumber) ? jobIdNumber : null;\n      this.queryInfo.userName = this.inputUserName;\n      this.queryInfo.content = this.inputContent;\n\n      const _this = this;\n      axios.get(\"comment\", { params: _this.queryInfo }).then((resp) => {\n        _this.commentList = resp.data.data;\n        _this.total = resp.data.total;\n        _this.queryInfo.pageSize = resp.data.pageSize;\n        _this.queryInfo.pageNum = resp.data.pageNum;\n      });\n    },\n    handleSizeChange(newSize) {\n      this.queryInfo.pageSize = newSize;\n      this.getCommentList();\n    },\n    handleCurrentChange(newPage) {\n      this.queryInfo.pageNum = newPage;\n      this.getCommentList();\n    },\n    async deleteCommentById(id) {\n      const _this = this;\n      const resp = await this.$confirm(\"此操作将永久删除该评论, 是否继续?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\",\n      }).catch((err) => err);\n\n      if (resp == \"cancel\") {\n        return _this.$message.info(\"已取消删除\");\n      }\n\n      let success = true;\n      await axios.delete(\"comment/\" + id).then((resp) => {\n        if (resp.data.code !== 200) {\n          success = false;\n        }\n      });\n      if (!success) return _this.$message.error(\"删除评论失败！\");\n      this.getCommentList();\n      this.$message.success(\"删除评论成功！\");\n    },\n  },\n};\n</script>\n\n<style scoped>\n</style>\n"]}]}