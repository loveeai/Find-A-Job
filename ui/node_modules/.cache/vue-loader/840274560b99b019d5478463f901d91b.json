        ]\n        }\n      ],\n      isCollapsed: false\n    };\n  },\n  methods: {\n    toggleCollapse() {\n      this.isCollapsed = !this.isCollapsed;\n    },\n    toWelcome() {\n      this.$router.push(\"/statistics\");\n    },\n    handleCommand() {\n      window.sessionStorage.clear();\n      this.$router.push(\"/login\");\n    }\n  }\n};\n</script>\n\n<style scoped>\n.home-container {\n  height: 100%;\n}\n\n.el-header {\n  background-color: #39424b;\n  display: flex;\n  justify-content: space-between;\n  padding: 0 24px 0 14px;\n  align-items: center;\n  color: whitesmoke;\n  font-size: 20px;\n}\n\n.el-aside {\n  background-color: #39424b;\n}\n\n.toggle-button {\n  background-color: #4a5064;\n  font-size: 10px;\n  line-height: 24px;\n  color: #fff;\n  text-align: center;\n  letter-spacing: 0.1em;\n  cursor: pointer;\n}\n\n.span-container {\n  cursor: pointer;\n  font-weight: 600;\n}\n\n.el-main {\n  background-color: #f5f5f5;\n}\n\n.el-menu {\n  border: 0;\n}\n\n.el-dropdown-link {\n  cursor: pointer;\n  color: #409eff;\n}\n\n.el-icon-arrow-down {\n  font-size: 12px;\n}\n</style>\n"]}]}