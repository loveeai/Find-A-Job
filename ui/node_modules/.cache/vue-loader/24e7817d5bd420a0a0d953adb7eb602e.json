breadcrumb separator-class=\"el-icon-arrow-right\">\r\n        <el-breadcrumb-item :to=\"{ path: '/welcome' }\">首页</el-breadcrumb-item>\r\n        <el-breadcrumb-item>实验室室设备管理</el-breadcrumb-item>\r\n        <el-breadcrumb-item>实验室室设备管理</el-breadcrumb-item>\r\n      </el-breadcrumb>\r\n    </div>\r\n    <el-card class=\"box-card\">\r\n      <el-row :gutter=\"20\" class=\"row2\">\r\n        <el-col :span=\"5\">\r\n          <el-input v-model=\"selectedNameCn\" placeholder=\"请输入名称\" clearable></el-input>\r\n        </el-col>\r\n        <el-col :span=\"2\">\r\n          <el-button icon=\"el-icon-search\" @click=\"getList\">搜索</el-button>\r\n        </el-col>\r\n        <el-col :span=\"2\">\r\n          <el-button type=\"primary\" style=\"background-color: chocolate;color: aliceblue;\"\r\n            @click=\"addDialogVisible = true\" icon=\"el-icon-plus\">添加</el-button>\r\n        </el-col>\r\n        <el-col :span=\"4\">\r\n          <el-button type=\"danger\" @click=\"multipleDelete\">批量删除</el-button>\r\n        </el-col>\r\n      </el-row>\r\n      <!--    列表字段-->\r\n      <el-table :data=\"volunteerList\" style=\"width: 100%\" border stripe @selection-change=\"handleSelectionChange\">\r\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\r\n        <el-table-column type=\"index\" label=\"#\"></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"设备名称\"></el-table-column>\r\n        <el-table-column prop=\"nums\" label=\"设备数量\"></el-table-column>\r\n        <!--      操作按钮-->\r\n        <el-table-column label=\"操作\" width=\"250\">\r\n          <template slot-scope=\"scope\">\r\n            <el-tooltip effect=\"dark\" content=\"借用\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button size=\"mini\" @click=\"jieyongDialog(scope.row.id)\" type=\"success\">借用</el-button>\r\n            </el-tooltip>\r\n            <el-tooltip effect=\"dark\" content=\"修改信息\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button size=\"mini\" @click=\"showEditDialog(scope.row.id)\"\r\n                style=\"background-color: chocolate;color: aliceblue;\">编辑</el-button>\r\n            </el-tooltip>\r\n            <el-tooltip effect=\"dark\" content=\"删除信息\" placement=\"top\" :enterable=\"false\" :open-delay=\"500\">\r\n              <el-button type=\"danger\" size=\"mini\" @click=\"deleteMovieById(scope.row.id)\">删除</el-button>\r\n            </el-tooltip>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n      <!--分页区域-->\r\n      <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\r\n        :current-page=\"queryInfo.pageNum\" :page-sizes=\"[5, 7, 9]\" :page-size=\"queryInfo.pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\" :total=\"total\"></el-pagination>\r\n    </el-card>\r\n    <!--添加对话框-->\r\n    <el-dialog title=\"添加\" :visible.sync=\"addDialogVisible\" width=\"60%\" @close=\"addDialogClosed\">\r\n      <!--内容主题区-->\r\n      <el-form :model=\"addForm\" :rules=\"addFormRules\" ref=\"addFormRef\" label-width=\"120px\">\r\n        <el-form-item label=\"设备名称\" prop=\"name\">\r\n          <el-input v-model=\"addForm.name\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"设备介绍\" prop=\"content\">\r\n          <el-input v-model=\"addForm.content\" type=\"textarea\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"总数量\" prop=\"nums\">\r\n          <el-input v-model=\"addForm.nums\" type=\"number\" min=\"1\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"图片\">\r\n          <el-upload action list-type=\"picture-card\" :auto-upload=\"false\" :limit=\"1\" :file-list=\"poster\"\r\n            :on-exceed=\"handleExceed\" :on-change=\"handleChangeP\" :on-success=\"handleSuccessP\" :on-error=\"handleError\"\r\n            ref=\"posterRef\" :http-request=\"submitFileP\">\r\n            <i slot=\"default\" class=\"el-icon-plus\"></i>\r\n            <div slot=\"file\" slot-scope=\"{file}\">\r\n              <img class=\"el-upload-list__item-thumbnail\" :src=\"file.url\" alt />\r\n              <span class=\"el-upload-list__item-actions\">\r\n                <span class=\"el-upload-list__item-preview\" @click=\"handlePictureCardPreviewP(file)\">\r\n                  <i class=\"el-icon-zoom-in\"></i>\r\n                </span>\r\n                <span v-if=\"!disabled\" class=\"el-upload-list__item-delete\" @click=\"handleRemoveP(file)\">\r\n                  <i class=\"el-icon-delete\"></i>\r\n                </span>\r\n              </span>\r\n            </div>\r\n          </el-upload>\r\n        </el-form-item>\r\n      </el-form>\r\n      <!--底部区域-->\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"addDialogVisible = false\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"add\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n    <!-- 修改信息对话框 -->\r\n    <el-dialog title=\"修改信息\" :visible.sync=\"editDialogVisible\" width=\"60%\" @close=\"editDialogClosed\">\r\n      <el-form :model=\"editForm\" :rules=\"editFormRules\" ref=\"editFormRef\" label-width=\"120px\">\r\n\r\n        <el-form-item label=\"设备名称\" prop=\"name\">\r\n          <el-input v-model=\"editForm.name\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"设备介绍\" prop=\"content\">\r\n          <el-input v-model=\"editForm.content\" type=\"textarea\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"总数量\" prop=\"nums\">\r\n          <el-input v-model=\"editForm.nums\" type=\"number\" min=\"1\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"图片\">\r\n          <el-upload action list-type=\"picture-card\" :auto-upload=\"false\" :limit=\"1\" :file-list=\"poster\"\r\n            :on-exceed=\"handleExceed\" :on-change=\"handleChangeP\" :on-success=\"handleSuccessP\" :on-error=\"handleError\"\r\n            ref=\"posterEditRef\" :http-request=\"submitFileP\">\r\n            <i slot=\"default\" class=\"el-icon-plus\"></i>\r\n            <div slot=\"file\" slot-scope=\"{file}\">\r\n              <img class=\"el-upload-list__item-thumbnail\" :src=\"file.url\" alt />\r\n              <span class=\"el-upload-list__item-actions\">\r\n                <span class=\"el-upload-list__item-preview\" @click=\"handlePictureCardPreviewP(file)\">\r\n                  <i class=\"el-icon-zoom-in\"></i>\r\n                </span>\r\n                <span v-if=\"!disabled\" class=\"el-upload-list__item-delete\" @click=\"handleRemoveP(file)\">\r\n                  <i class=\"el-icon-delete\"></i>\r\n                </span>\r\n              </span>\r\n            </div>\r\n          </el-upload>\r\n          <!--放大预览-->\r\n          <el-dialog :visible.sync=\"dialogVisible\">\r\n            <img width=\"100%\" :src=\"dialogImageUrl\" alt />\r\n          </el-dialog>\r\n        </el-form-item>\r\n      </el-form>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"editDialogVisible = false\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"editHallInfo\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n\r\n\r\n    <el-dialog title=\"借用设备\" :visible.sync=\"jieyongDialogVisable\" width=\"60%\" @close=\"jieyongDialogClosed\">\r\n      <!--内容主题区-->\r\n      <el-form :model=\"recordFrom\" :rules=\"recordFormRules\" ref=\"recordFormRef\" label-width=\"120px\">\r\n        <el-form-item label=\"借用数量\" prop=\"nums\">\r\n          <el-input v-model=\"recordFrom.nums\" type=\"number\" min=\"1\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"归还时间\" prop=\"gtimes\">\r\n          <el-date-picker v-model=\"recordFrom.gtimes\" value-format=\"yyyy-MM-dd HH:mm:ss\" type=\"datetime\"\r\n            placeholder=\"选择日期\">\r\n          </el-date-picker>\r\n        </el-form-item>\r\n        <el-form-item label=\"姓名\" prop=\"name\">\r\n          <el-input v-model=\"recordFrom.name\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"预留手机号\" prop=\"phone\">\r\n          <el-input v-model=\"recordFrom.phone\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"用途\" prop=\"content\">\r\n          <el-input v-model=\"recordFrom.content\" type=\"textarea\" rows=\"5\"></el-input>\r\n        </el-form-item>\r\n      </el-form>\r\n      <!--底部区域-->\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"jieyongDialogVisable = false\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"addRecord\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n\r\n\r\n\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: \"eduipment\",\r\n  data() {\r\n    return {\r\n      recordFrom: {\r\n        nums: 1,\r\n      },\r\n      queryInfo: {\r\n        selectedNameCn: \"\",\r\n        pageNum: 1,\r\n        pageSize: 7,\r\n      },\r\n      jieyongDialogVisable: false,\r\n      total: 0,\r\n      url: \"http://localhost:8181/\",\r\n      //控制对话框的显示与隐藏\r\n      addDialogVisible: false,\r\n      selectedDate: [],\r\n      selectedNameCn: \"\",\r\n      categoryList: [],\r\n      volunteerList: [],\r\n      editForm: {},\r\n      editActorForm: null,\r\n      editCategoryForm: [],\r\n      editDialogVisible: false,\r\n      editActorVisible: false,\r\n      multipleSelection: [],\r\n      dialogVisible: false,\r\n      dialogImageUrl: \"\",\r\n      disabled: false,\r\n      //封面增删变量\r\n      poster: [],\r\n      //发送给后端的JSON图片\r\n      posterL: [],\r\n      deletePostList: [],\r\n      //添加删除图片集 动态绑定图片列表\r\n      pics: [],\r\n      // 发送给后端的JSON图片数组\r\n      pictureList: [],\r\n      picNums: 0,\r\n      deletePicList: [],\r\n      //添加表单数据\r\n      classifyList: [],\r\n      addForm: {\r\n\r\n      },\r\n      eduId: '',\r\n      recordFormRules: {\r\n        nums: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        gtimes: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        name: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        phone: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        content: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n      },\r\n      //添加验证表单规则对象\r\n      addFormRules: {\r\n        name: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        content: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        nums: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n      },\r\n      //修改验证表单规则对象\r\n      editFormRules: {\r\n        name: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        content: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n        nums: [{ required: true, message: \"请输入\", trigger: \"blur\" }],\r\n      }\r\n    };\r\n  },\r\n  created() {\r\n    this.getList();\r\n  },\r\n  methods: {\r\n    getList() {\r\n      if (JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser.roleId == 2) {\r\n        this.queryInfo.userId = JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser.userId\r\n      }\r\n      this.queryInfo.name = this.selectedNameCn;\r\n      const _this = this;\r\n      axios.get(\"eduipment\", { params: _this.queryInfo }).then(resp => {\r\n        _this.volunteerList = resp.data.data;\r\n        _this.total = resp.data.total;\r\n        _this.queryInfo.pageSize = resp.data.pageSize;\r\n        _this.queryInfo.pageNum = resp.data.pageNum;\r\n      });\r\n    },\r\n    jieyongDialog(id) {\r\n      this.eduId = id\r\n      this.jieyongDialogVisable = true\r\n    },\r\n    ifShow(id) {\r\n      let i = 0;\r\n      let l = true;\r\n      for (i = 0; i < this.editCategoryForm.length; i++) {\r\n        if (id == this.editCategoryForm[i].movieCategoryId) {\r\n          l = false;\r\n        }\r\n      }\r\n      return l;\r\n    },\r\n    handleSizeChange(newSize) {\r\n      this.queryInfo.pageSize = newSize;\r\n      this.getList();\r\n      console.log(newSize);\r\n    },\r\n    handleCurrentChange(newPage) {\r\n      this.queryInfo.pageNum = newPage;\r\n      this.getList();\r\n      console.log(newPage);\r\n    },\r\n    jieyongDialogClosed() {\r\n      this.recordFrom = {},\r\n        this.eduId = ''\r\n    },\r\n    async submitFile() {\r\n      const _this = this;\r\n      for (let i = 0; i < this.pics.length; i++) {\r\n        let formData = new FormData();\r\n        if (this.pics[i].status === \"success\") {\r\n          let s = this.pics[i].url;\r\n          this.pictureList.push(s.substring(s.indexOf(\"/images\")));\r\n          continue;\r\n        }\r\n        let file = this.pics[i].raw;\r\n        formData.append(\"file\", file);\r\n        await axios.post(\"upload/movie\", formData).then(response => {\r\n          _this.pictureList.push(response.data.data);\r\n        });\r\n      }\r\n    },\r\n    async submitFileP() {\r\n      const _this = this;\r\n      for (let i = 0; i < this.poster.length; i++) {\r\n        let formData = new FormData();\r\n        if (this.poster[i].status === \"success\") {\r\n          let s = this.poster[i].url;\r\n          this.posterL.push(s.substring(s.indexOf(\"/images\")));\r\n          continue;\r\n        }\r\n        console.log(11111);\r\n        let file = this.poster[i].raw;\r\n        formData.append(\"file\", file);\r\n        await axios.post(\"upload/movie\", formData).then(response => {\r\n          _this.posterL.push(response.data.data);\r\n        });\r\n      }\r\n    },\r\n    // 监听添加对话框的关闭事件\r\n    addDialogClosed() {\r\n      this.$refs.addFormRef.resetFields();\r\n      this.$refs.posterRef.clearFiles();\r\n      this.addForm.videoUrl = ''\r\n      this.poster = [];\r\n      this.posterL = [];\r\n      this.pics = [];\r\n      this.pictureList = [];\r\n    },\r\n    // 监听添加按钮\r\n    async add() {\r\n      await this.submitFile();\r\n      await this.submitFileP();\r\n      this.addForm.userId = JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser.userId\r\n      this.addForm.pictures = JSON.stringify(this.pictureList);\r\n      this.addForm.poster = JSON.stringify(this.posterL);\r\n      const _this = this;\r\n      this.$refs.addFormRef.validate(async valid => {\r\n        console.log(valid);\r\n        if (!valid) return;\r\n        //预校验成功，发网络请求\r\n        axios.defaults.headers.post[\"Content-Type\"] = \"application/json\";\r\n        await axios.post(\"eduipment\", JSON.stringify(_this.addForm)).then(resp => {\r\n          console.log(resp);\r\n          if (resp.data.code !== 200) {\r\n            this.$message.error(\"添加信息失败！\");\r\n          }\r\n        });\r\n        //隐藏添加对话框\r\n        this.addDialogVisible = false;\r\n        //重新加载列表\r\n        this.getList();\r\n        this.$message.success(\"添加信息成功！\");\r\n      });\r\n    },\r\n\r\n\r\n    async addRecord() {\r\n      this.recordFrom.userId = JSON.parse(window.sessionStorage.getItem('loginUser')).sysUser.userId\r\n      this.recordFrom.eduId = this.eduId\r\n      this.recordFrom.status = '使用中'\r\n      const _this = this;\r\n      this.$refs.recordFormRef.validate(async valid => {\r\n        console.log(valid);\r\n        if (!valid) return;\r\n        //预校验成功，发网络请求\r\n        axios.defaults.headers.post[\"Content-Type\"] = \"application/json\";\r\n        await axios.post(\"record\", JSON.stringify(_this.recordFrom)).then(resp => {\r\n          console.log(resp);\r\n          if (resp.data.code !== 200) {\r\n            this.$message.error(resp.data.msg);\r\n          }else{\r\n    //隐藏添加对话框\r\n    this.jieyongDialogVisable = false;\r\n        //重新加载列表\r\n        this.getList();\r\n        this.$message.success(\"借用信息成功！\")\r\n          }\r\n       ;\r\n        });\r\n       \r\n      });\r\n    },\r\n\r\n\r\n\r\n    // 监听修改对话框的关闭事件\r\n    editDialogClosed() {\r\n      this.$refs.editFormRef.resetFields();\r\n      // this.$refs.pictureEditRef.clearFiles();\r\n      this.$refs.posterEditRef.clearFiles();\r\n      this.pics = [];\r\n      this.pictureList = [];\r\n      this.posterL = [];\r\n      this.poster = [];\r\n    },\r\n    // 修改信息对话框\r\n    async editHallInfo() {\r\n      await this.submitFile();\r\n      await this.submitFileP();\r\n      this.editForm.pictures = JSON.stringify(this.pictureList);\r\n      this.editForm.poster = JSON.stringify(this.posterL);\r\n      this.$refs.editFormRef.validate(async valid => {\r\n        const _this = this;\r\n        if (!valid) return;\r\n        let success = true;\r\n        axios.defaults.headers.put[\"Content-Type\"] = \"application/json\";\r\n        await axios.put(\"eduipment\", JSON.stringify(_this.editForm)).then(resp => {\r\n          if (resp.data.code !== 200) {\r\n            this.$message.error(\"修改信息失败！\");\r\n            success = false;\r\n          }\r\n        });\r\n        if (!success) return;\r\n        for (let s of this.deletePicList) {\r\n          await axios.get(\r\n            \"/upload/delete?filePath=\" + s.substring(s.indexOf(\"/images\"))\r\n          );\r\n        }\r\n        for (let s of this.deletePostList) {\r\n          await axios.get(\r\n            \"/upload/delete?filePath=\" + s.substring(s.indexOf(\"/images\"))\r\n          );\r\n        }\r\n        this.editDialogVisible = false;\r\n        this.getList();\r\n        this.$message.success(\"修改信息成功！\");\r\n      });\r\n    },\r\n\r\n    handleChange(file, filelist) {\r\n      this.pics = filelist.slice(0);\r\n      console.log(this.pics);\r\n    },\r\n    handleChangeP(file, filelist) {\r\n      this.poster = filelist;\r\n      console.log(this.poster);\r\n    },\r\n    handleSuccess(response) {\r\n      this.pictureList.push(response.data);\r\n      this.addForm = JSON.stringify(this.pictureList);\r\n      this.editForm = JSON.stringify(this.pictureList);\r\n    },\r\n    handleSuccessP(response) {\r\n      console.log(response);\r\n      this.posterL.push(response.data);\r\n      this.addForm = JSON.stringify(this.posterL);\r\n      this.editForm = JSON.stringify(this.posterL);\r\n    },\r\n    handlePictureCardPreview(file) {\r\n      this.dialogImageUrl = file.url;\r\n      this.dialogVisible = true;\r\n    },\r\n    handlePictureCardPreviewP(file) {\r\n      this.dialogImageUrl = file.url;\r\n      this.dialogVisible = true;\r\n    },\r\n    handleRemove(file, filelist) {\r\n      const filePath = file.url;\r\n      console.log(filePath);\r\n      const idx = this.pics.findIndex(x => x.url === filePath);\r\n      if (file.status === \"success\") {\r\n        this.deletePicList.push(file.url);\r\n      }\r\n      this.pics.splice(idx, 1);\r\n    },\r\n    handleRemoveP(file) {\r\n      const filePath = file.url;\r\n      console.log(filePath);\r\n      const idx = this.poster.findIndex(x => x.url === filePath);\r\n      if (file.status === \"success\") {\r\n        this.deletePostList.push(file.url);\r\n      }\r\n      this.poster.splice(idx, 1);\r\n    },\r\n    handleError(err) {\r\n      console.log(err);\r\n    },\r\n    // 显示修改对话框，回显数据\r\n    async showEditDialog(id1) {\r\n      const _this = this;\r\n      await axios.get(\"eduipment/\" + id1).then(resp => {\r\n        _this.editForm = resp.data.data;\r\n        _this.editForm.videoUrl = 'http://127.0.0.1:8182' + resp.data.data.video\r\n      });\r\n\r\n      for (const item of JSON.parse(this.editForm.poster)) {\r\n        console.log(\"1111111111\");\r\n        let pic = {};\r\n        pic[\"name\"] = \"\";\r\n        console.log(\"item=\" + item + \"1111111111\" + \"base=\" + this.global.base);\r\n        pic[\"url\"] = this.global.base + item;\r\n\r\n        this.poster.push(pic);\r\n      }\r\n      this.editDialogVisible = true;\r\n    },\r\n    // 监听多选框变化\r\n    handleSelectionChange(val) {\r\n      this.multipleSelection = val;\r\n    },\r\n    // 批量删除\r\n    async multipleDelete() {\r\n      const _this