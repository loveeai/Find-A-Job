<view class="page">
  <view class="hero-card">
    <text class="hero-title">修改密码</text>
    <text class="hero-desc">请先验证原密码，修改成功后需要重新登录。</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="label">原密码</text>
      <input
        class="input"
        password
        maxlength="{{passwordMaxLength}}"
        value="{{form.oldPassword}}"
        bindinput="onFieldChange"
        data-field="oldPassword"
        placeholder-class="input-placeholder"
        placeholder="{{passwordPlaceholder}}"
      />
      <text class="field-rule">{{passwordRuleHint}}</text>
    </view>

    <view class="form-item">
      <text class="label">新密码</text>
      <input
        class="input"
        password
        maxlength="{{passwordMaxLength}}"
        value="{{form.newPassword}}"
        bindinput="onFieldChange"
        data-field="newPassword"
        placeholder-class="input-placeholder"
        placeholder="{{passwordPlaceholder}}"
      />
      <text class="field-rule">{{passwordRuleHint}}</text>
    </view>

    <view class="form-item">
      <text class="label">确认新密码</text>
      <input
        class="input"
        password
        maxlength="{{passwordMaxLength}}"
        value="{{form.confirmPassword}}"
        bindinput="onFieldChange"
        data-field="confirmPassword"
        placeholder-class="input-placeholder"
        placeholder="{{passwordPlaceholder}}"
      />
      <text class="field-rule">{{passwordRuleHint}}</text>
    </view>
  </view>

  <view class="tips-card">
    <text class="tips-title">输入规则</text>
    <text class="tips-item">1. 密码长度为 6-20 位。</text>
    <text class="tips-item">2. 仅允许字母、数字和英文符号，不支持空格或中文。</text>
    <text class="tips-item">3. 修改成功后当前登录状态会失效，需要重新登录。</text>
  </view>

  <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="submit">确认修改</button>
</view>
