.page {
  min-height: 100vh;
  padding: 24rpx;
  background: linear-gradient(180deg, #0eb85d 0%, #0eb85d 220rpx, #f6f8fa 220rpx, #f6f8fa 100%);
  box-sizing: border-box;
}

.hero-card,
.form-card,
.tips-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 48, 0.06);
}

.hero-card {
  padding: 32rpx 28rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2430;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #65707f;
}

.form-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.input {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fafb;
  border: 2rpx solid #e6ecf0;
  font-size: 28rpx;
  color: #1f2430;
  box-sizing: border-box;
}

.input-placeholder {
  color: #98a2ad;
  font-size: 24rpx;
}

.field-rule {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7c8795;
  white-space: normal;
  word-break: break-all;
}

.tips-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2430;
}

.tips-item {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #65707f;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
}
