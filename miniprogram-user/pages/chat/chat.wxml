<view class="page">
  <view class="chat-head">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="peer-info">
      <image class="peer-avatar" src="{{peerUserAvatar || '/images/avatar.png'}}" mode="aspectFill"></image>
      <view class="peer-body">
        <text class="peer-name">{{peerUserName}}</text>
        <text class="peer-desc">消息实时同步</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading && !messages.length}}" class="state-card">
    <text>消息加载中...</text>
  </view>

  <scroll-view
    wx:else
    class="message-list"
    scroll-y="true"
    scroll-with-animation="true"
    scroll-into-view="{{scrollIntoView}}"
  >
    <view wx:if="{{!messages.length}}" class="empty-state">
      <text class="empty-title">开始沟通吧</text>
      <text class="empty-desc">发送第一条消息，和对方建立联系。</text>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="message-{{item.id}}"
      class="message-row {{item.isOwn ? 'own' : ''}}"
    >
      <image
        class="message-avatar"
        src="{{item.isOwn ? currentUserAvatar : peerUserAvatar}}"
        mode="aspectFill"
      ></image>
      <view class="message-bubble {{item.isOwn ? 'own' : ''}}">
        <text class="message-content">{{item.content}}</text>
        <view class="message-meta">
          <text class="message-time">{{item.timeText}}</text>
          <text wx:if="{{item.isOwn && item.isPending}}" class="message-status">发送中</text>
          <text wx:if="{{item.isOwn && item.isFailed}}" class="message-status failed">发送失败</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      confirm-type="send"
      placeholder="请输入消息"
    />
    <button class="send-btn" bindtap="sendMessage" disabled="{{!inputValue}}">发送</button>
  </view>
</view>
