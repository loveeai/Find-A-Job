<view class="page" wx:if="{{jobInfo}}">
  <view class="hero-card">
    <view class="hero-top">
      <view class="hero-main">
        <text class="job-title">{{jobInfo.title}}</text>
        <text class="job-company">{{jobInfo.companyName}}</text>
      </view>
      <text class="job-salary">{{jobInfo.salary}}</text>
    </view>

    <view class="badge-row">
      <text class="badge">{{jobInfo.companyIndustry}}</text>
      <text class="badge">{{jobInfo.jobType}}</text>
      <text wx:if="{{jobInfo.recruitNumber}}" class="badge accent">招 {{jobInfo.recruitNumber}} 人</text>
    </view>

    <view class="meta-line">
      <view class="meta-item">
        <van-icon name="location-o" size="28rpx" color="#8a8f99"></van-icon>
        <text>{{jobInfo.companyLocation}}</text>
      </view>
      <text wx:if="{{jobInfo.publishTime}}" class="meta-time">发布时间 {{jobInfo.publishTime}}</text>
    </view>
  </view>

  <view class="section-card company-card">
    <view class="section-head">
      <text class="section-title">企业信息</text>
      <view class="section-link" bindtap="goToCompanyDetail">
        <text>查看详情</text>
        <van-icon name="arrow" size="26rpx" color="#07c160"></van-icon>
      </view>
    </view>

    <view class="company-row">
      <image class="company-logo" src="{{jobInfo.companyLogo}}" mode="aspectFill"></image>
      <view class="company-body">
        <text class="company-name">{{jobInfo.companyName}}</text>
        <text class="company-extra">{{jobInfo.companyIndustry}}</text>
        <text class="company-extra">{{jobInfo.companyScale}}</text>
        <text class="company-address">{{jobInfo.companyLocation}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">岗位描述</text>
    </view>
    <text class="rich-text">{{jobInfo.description}}</text>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">福利标签</text>
    </view>
    <view class="benefit-row" wx:if="{{jobInfo.welfare.length}}">
      <text class="benefit-tag" wx:for="{{jobInfo.welfare}}" wx:key="index">{{item}}</text>
    </view>
    <text wx:else class="empty-inline">企业暂未填写福利信息</text>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">职位投诉</text>
    </view>
    <text class="complaint-tip">如果发现虚假、过期或违规招聘信息，可填写原因进行投诉，管理员会在后台查看处理。</text>
    <button class="btn-default complaint-trigger" bindtap="openComplaintModal">投诉该职位</button>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">职位评论</text>
    </view>

    <view class="comment-editor">
      <input
        class="comment-input"
        maxlength="255"
        placeholder="说说你对这份职位的看法"
        value="{{commentContent}}"
        bindinput="onCommentInput"
      />
      <button class="btn-primary comment-btn" bindtap="submitComment">发布评论</button>
    </view>

    <view wx:if="{{commentList.length}}" class="comment-list">
      <view class="comment-item" wx:for="{{commentList}}" wx:key="id">
        <image class="comment-avatar" src="{{item.userPicture}}" mode="aspectFill"></image>
        <view class="comment-body">
          <view class="comment-head">
            <text class="comment-user">{{item.userName}}</text>
            <text class="comment-time">{{item.times}}</text>
          </view>
          <text class="comment-text">{{item.content}}</text>
        </view>
      </view>
    </view>

    <view wx:elif="{{isLoadingComments}}" class="comment-empty">评论加载中...</view>
    <view wx:else class="comment-empty">还没有评论，来抢一个沙发吧</view>
  </view>

  <view class="bottom-bar">
    <button class="bottom-btn collect-btn {{jobInfo.isCollected ? 'active' : ''}}" bindtap="collectJob">
      <van-icon
        name="{{jobInfo.isCollected ? 'star' : 'star-o'}}"
        size="34rpx"
        color="{{jobInfo.isCollected ? '#ff8a00' : '#07c160'}}"
      ></van-icon>
      <text>{{jobInfo.isCollected ? '已收藏' : '收藏职位'}}</text>
    </button>
    <button class="bottom-btn apply-btn" bindtap="applyJob">投递简历</button>
  </view>

  <view wx:if="{{showComplaintModal}}" class="mask" bindtap="cancelComplaint"></view>
  <view wx:if="{{showComplaintModal}}" class="resume-modal complaint-modal">
    <view class="modal-head">
      <text class="modal-title">投诉职位</text>
      <van-icon name="cross" size="30rpx" color="#8a8f99" bindtap="cancelComplaint"></van-icon>
    </view>

    <view class="modal-section">
      <text class="modal-section-title">投诉原因</text>
      <textarea
        class="complaint-textarea"
        maxlength="500"
        placeholder="请输入投诉原因，如虚假招聘、薪资不实、职位信息违规等"
        value="{{complaintReason}}"
        auto-height
        bindinput="onComplaintReasonInput"
      ></textarea>
      <text class="complaint-counter">{{complaintReason.length}}/500</text>
    </view>

    <view class="modal-actions">
      <button class="btn-default modal-btn" bindtap="cancelComplaint">取消</button>
      <button
        class="btn-primary modal-btn"
        bindtap="submitComplaint"
        loading="{{isSubmittingComplaint}}"
        disabled="{{isSubmittingComplaint}}"
      >
        提交投诉
      </button>
    </view>
  </view>

  <view wx:if="{{showResumeSelect}}" class="mask" bindtap="cancelResumeSelect"></view>
  <view wx:if="{{showResumeSelect}}" class="resume-modal">
    <view class="modal-head">
      <text class="modal-title">选择要投递的简历附件</text>
      <van-icon name="cross" size="30rpx" color="#8a8f99" bindtap="cancelResumeSelect"></van-icon>
    </view>

    <view class="modal-section">
      <text class="modal-section-title">1. 选择简历</text>

      <radio-group wx:if="{{hasMultipleResumes}}" bindchange="onResumeChange">
        <label class="choice-item" wx:for="{{resumeOptions}}" wx:key="id">
          <view class="choice-main">
            <view class="choice-info">
              <text class="resume-title">{{item.title}}</text>
              <text class="resume-subtitle">{{item.subtitle}}</text>
            </view>
            <radio value="{{item.id}}" checked="{{selectedResumeId === item.id}}" color="#07c160" />
          </view>
        </label>
      </radio-group>

      <view wx:elif="{{selectedResumeInfo}}" class="single-choice-card">
        <text class="single-choice-tip">当前账号仅有 1 份简历，已自动选中</text>
        <text class="resume-title">{{selectedResumeInfo.title}}</text>
        <text class="resume-subtitle">{{selectedResumeInfo.subtitle}}</text>
      </view>
    </view>

    <view class="modal-section">
      <view class="attachment-head">
        <text class="modal-section-title">2. 选择附件</text>
        <text class="attachment-tip">投递记录会保留本次选择的附件</text>
      </view>

      <view wx:if="{{isLoadingResumeFiles}}" class="attachment-state">附件加载中...</view>

      <radio-group wx:elif="{{hasMultipleResumeFiles}}" bindchange="onResumeFileChange">
        <label class="choice-item" wx:for="{{resumeFileOptions}}" wx:key="id">
          <view class="choice-main">
            <view class="choice-info">
              <text class="attachment-name">{{item.fileName}}</text>
              <text class="attachment-size">{{item.formattedSize}}</text>
            </view>
            <radio value="{{item.id}}" checked="{{selectedResumeFileId === item.id}}" color="#07c160" />
          </view>
        </label>
      </radio-group>

      <view wx:elif="{{selectedResumeFileInfo}}" class="single-choice-card">
        <text class="single-choice-tip">当前简历仅有 1 份附件，已自动选中</text>
        <text class="attachment-name">{{selectedResumeFileInfo.fileName}}</text>
        <text class="attachment-size">{{selectedResumeFileInfo.formattedSize}}</text>
      </view>

      <view wx:else class="empty-attachment">
        <text class="attachment-state">当前简历还没有可投递的附件</text>
        <button class="btn-default upload-link-btn" bindtap="goToResumePage">去上传附件</button>
      </view>
    </view>

    <view class="modal-actions">
      <button class="btn-default modal-btn" bindtap="cancelResumeSelect">取消</button>
      <button class="btn-primary modal-btn" bindtap="confirmResumeSelect">确认投递</button>
    </view>
  </view>
</view>

<view wx:else class="loading-page">
  <text>职位详情加载中...</text>
</view>
