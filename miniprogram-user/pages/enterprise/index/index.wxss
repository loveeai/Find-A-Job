.page {
  min-height: 100vh;
  padding: 24rpx;
  background: linear-gradient(180deg, #eef7f1 0%, #f6f8fa 260rpx, #f6f8fa 100%);
  box-sizing: border-box;
}

.hero-swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(7, 193, 96, 0.12);
}

.hero-image {
  width: 100%;
  height: 100%;
}

.quick-card,
.state-card,
.candidate-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 48, 0.06);
}

.quick-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 22rpx;
  margin-top: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 170rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #07c160 0%, #14ad6e 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.quick-item.wide {
  grid-column: 1 / -1;
  min-height: 144rpx;
}

.section-head {
  margin: 28rpx 0 20rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2430;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.state-card {
  padding: 56rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8f99;
}

.candidate-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.candidate-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.candidate-profile {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.candidate-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f4f7;
  flex-shrink: 0;
}

.candidate-main {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2430;
}

.candidate-job {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #07c160;
}

.collect-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f7fff9;
  border: 2rpx solid #dff5e5;
  color: #07c160;
  font-size: 24rpx;
  flex-shrink: 0;
}

.collect-btn.active {
  background: #fff7eb;
  border-color: #ffe3b8;
  color: #ff8a00;
}

.candidate-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.candidate-meta text {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #58606d;
  font-size: 24rpx;
}

.candidate-contact {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #58606d;
}

.skill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.skill-tag {
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: #edf9f1;
  color: #07c160;
  font-size: 24rpx;
}
