.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f8fa;
  box-sizing: border-box;
}

.page-head {
  margin-bottom: 20rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2430;
}

.page-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.state-card {
  padding: 72rpx 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(31, 36, 48, 0.06);
  text-align: center;
  font-size: 28rpx;
  color: #8a8f99;
}

.application-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.application-card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(31, 36, 48, 0.06);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.job-info {
  flex: 1;
  min-width: 0;
}

.job-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2430;
  line-height: 1.4;
}

.company-name {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #58606d;
}

.status-badge {
  flex-shrink: 0;
  min-width: 124rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.status-badge.pending {
  background: #eef7ff;
  color: #2c7be5;
}

.status-badge.interview {
  background: #fff4e7;
  color: #f08c00;
}

.status-badge.reject {
  background: #fff0f0;
  color: #e15353;
}

.status-badge.hired {
  background: #edf9f1;
  color: #13a452;
}

.status-badge.default {
  background: #f2f4f7;
  color: #6b7280;
}

.job-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.meta-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f7f9fb;
  color: #58606d;
  font-size: 24rpx;
}

.meta-pill.salary {
  background: #fff3e2;
  color: #e46b00;
}

.candidate-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f9fbfc;
}

.candidate-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #edf1f4;
  flex-shrink: 0;
}

.candidate-body {
  flex: 1;
  min-width: 0;
}

.candidate-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.candidate-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2430;
}

.candidate-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #58606d;
  font-size: 22rpx;
}

.candidate-role {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #58606d;
}

.candidate-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7b8794;
}

.toggle-btn {
  flex-shrink: 0;
  min-width: 108rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0eb85d;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid #cfeedd;
}

.timeline-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.interview-box {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #f8fbff;
  font-size: 24rpx;
  color: #47607a;
}

.detail-panel {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f1f4f6;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.detail-item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f9fbfc;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #8a8f99;
}

.detail-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #1f2430;
  line-height: 1.5;
  word-break: break-word;
}

.intro-block {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f9fbfc;
}

.attachment-box {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f5faf7;
}

.intro-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2430;
}

.intro-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #58606d;
  line-height: 1.7;
  word-break: break-word;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.action-btn {
  min-width: 144rpx;
  height: 68rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
}

.ghost-btn {
  background: #ffffff;
  color: #0eb85d;
  border: 2rpx solid #cfeedd;
}

.primary-btn {
  background: #0eb85d;
  color: #ffffff;
}

.warn-btn {
  background: #fff3e2;
  color: #d97706;
}

.success-btn {
  background: #edf9f1;
  color: #13a452;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 99;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.38);
}

.modal-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 28rpx;
  background: #ffffff;
  overflow: hidden;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 2rpx solid #f1f4f6;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2430;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f7fa;
  color: #8a8f99;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.modal-body {
  padding: 28rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.picker-field,
.form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fafb;
  border: 2rpx solid #e6ecf0;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2430;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx 28rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cancel-btn {
  background: #f2f4f7;
  color: #6b7280;
}

.submit-btn {
  background: #0eb85d;
  color: #ffffff;
}
