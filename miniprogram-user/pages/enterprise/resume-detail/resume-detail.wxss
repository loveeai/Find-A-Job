.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  background: #f6f8fa;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.back-btn,
.head-placeholder {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(31, 36, 48, 0.05);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2430;
}

.state-card,
.hero-card,
.section-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 48, 0.06);
}

.state-card {
  padding: 60rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8f99;
}

.hero-card {
  display: flex;
  gap: 22rpx;
  padding: 30rpx;
  align-items: center;
  background: linear-gradient(180deg, #ffffff 0%, #f8fdf9 100%);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f2f4f7;
  flex-shrink: 0;
}

.hero-body {
  flex: 1;
  min-width: 0;
}

.resume-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2430;
}

.resume-role {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #07c160;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.badge {
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #58606d;
  font-size: 24rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2430;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f3f5f7;
}

.detail-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #8a8f99;
  flex-shrink: 0;
}

.detail-value {
  font-size: 28rpx;
  color: #1f2430;
  text-align: right;
  word-break: break-word;
}

.intro-text {
  font-size: 28rpx;
  line-height: 1.9;
  color: #38414f;
  white-space: pre-wrap;
  word-break: break-word;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -10rpx 24rpx rgba(31, 36, 48, 0.08);
  box-sizing: border-box;
}

.action-btn {
  flex: 1;
  height: 88rpx;
}

.action-btn.collected {
  border-color: #ffd591;
  background: #fff7e6;
  color: #d48806;
}
