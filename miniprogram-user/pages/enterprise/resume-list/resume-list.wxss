.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background-color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  border: 3rpx solid #e6e6e6;
  border-radius: 44rpx;
  padding: 0 36rpx;
  font-size: 30rpx;
  background-color: #fff;
  transition: all 0.3s ease;
}

.search-input:focus {
  border-color: #07c160;
  box-shadow: 0 0 0 6rpx rgba(7, 193, 96, 0.1);
  outline: none;
}

.filter-btn {
  width: 140rpx;
  height: 88rpx;
  font-size: 30rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
}

.filter-btn:active {
  background-color: #06ae56;
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
}

/* 筛选面板 */
.filter-panel {
  padding: 36rpx;
  background-color: #fff;
  border-radius: 24rpx;
  margin: 0 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.filter-item {
  margin-bottom: 50rpx;
}

.filter-item:last-child {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
  position: relative;
}

.filter-label::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 60rpx;
  height: 3rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

.filter-input {
  width: 100%;
  height: 88rpx;
  border: 3rpx solid #e6e6e6;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background-color: #fff;
  transition: all 0.3s ease;
}

.filter-input:focus {
  border-color: #07c160;
  box-shadow: 0 0 0 6rpx rgba(7, 193, 96, 0.1);
  outline: none;
}

.filter-input::placeholder {
  color: #ccc;
}

.filter-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 50rpx;
}

.reset-btn, .apply-btn {
  flex: 1;
}

/* 简历列表 */
.resume-list {
  padding: 20rpx;
}

.resume-item {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.resume-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
}

/* 简历头部 */
.resume-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.resume-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-right: 24rpx;
}

.education, .experience {
  font-size: 28rpx;
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(7, 193, 96, 0.2);
  font-weight: 500;
}

.collect-btn {
  font-size: 28rpx;
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  background-color: rgba(7, 193, 96, 0.1);
  color: #07c160;
  font-weight: 500;
  transition: all 0.3s ease;
  border: 2rpx solid rgba(7, 193, 96, 0.2);
}

.collect-btn:active {
  background-color: #07c160;
  color: #fff;
}

/* 简历内容 */
.resume-content {
  margin-bottom: 24rpx;
}

.content-item {
  margin-bottom: 20rpx;
  line-height: 1.6;
  font-size: 30rpx;
}

.content-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 30rpx;
  color: #999;
  margin-right: 16rpx;
  font-weight: 500;
}

.value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 简历底部 */
.resume-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 24rpx;
  border-top: 2rpx solid #f5f5f5;
}

.detail-btn {
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 30rpx;
  font-weight: 500;
}

/* 没有更多数据 */
.no-more {
  text-align: center;
  padding: 40rpx;
  color: #ccc;
  font-size: 30rpx;
  font-weight: 500;
}

/* 空数据 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 36rpx;
  font-weight: 500;
}