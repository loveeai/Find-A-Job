.container {
  min-height: 100vh;
  background: #f6f8fa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(31, 36, 48, 0.04);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2430;
}

.job-list {
  padding: 20rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.job-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(31, 36, 48, 0.06);
}

.title-section {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.job-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2430;
  line-height: 1.5;
}

.status-tag {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.active {
  background: #edf9f1;
  color: #07c160;
}

.status-tag.pending {
  background: #fff7e8;
  color: #fa8c16;
}

.status-tag.ended {
  background: #fff1f0;
  color: #ff4d4f;
}

.job-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.salary {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.location {
  font-size: 24rpx;
  color: #8a8f99;
}

.time-panel {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f8fafb;
}

.time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.time-row + .time-row {
  margin-top: 12rpx;
}

.time-label {
  font-size: 24rpx;
  color: #8a8f99;
}

.time-value {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #38414f;
}

.job-detail {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f8fafb;
}

.detail-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #58606d;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.load-more,
.no-more,
.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 24rpx;
  font-size: 26rpx;
  color: #8a8f99;
}
