.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f8fa;
  box-sizing: border-box;
}

.page-head {
  margin-bottom: 20rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2430;
}

.page-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.state-card,
.candidate-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 48, 0.06);
}

.state-card {
  padding: 72rpx 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8f99;
}

.candidate-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.candidate-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.candidate-profile {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.candidate-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f4f7;
  flex-shrink: 0;
}

.candidate-main {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2430;
}

.candidate-job {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #07c160;
}

.collect-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8a8f99;
}

.candidate-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.candidate-meta text {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #58606d;
  font-size: 24rpx;
}

.candidate-contact {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #58606d;
}

.skill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.skill-tag {
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: #edf9f1;
  color: #07c160;
  font-size: 24rpx;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.action-btn {
  min-width: 144rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
}

.primary-btn {
  background: linear-gradient(135deg, #07c160 0%, #14ad6e 100%);
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #dff5e5;
}

.warn-btn {
  background: #fff3f3;
  color: #e15353;
}
