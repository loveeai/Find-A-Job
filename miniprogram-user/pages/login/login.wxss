.page {
  min-height: 100vh;
  padding: 36rpx 24rpx;
  background: linear-gradient(180deg, #0eb85d 0%, #0eb85d 320rpx, #f6f8fa 320rpx, #f6f8fa 100%);
  box-sizing: border-box;
}

.hero {
  padding: 40rpx 8rpx 32rpx;
  color: #ffffff;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
}

.auth-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 18rpx 42rpx rgba(31, 36, 48, 0.12);
}

.mode-switch {
  display: flex;
  padding: 8rpx;
  background: #f2f5f7;
  border-radius: 999rpx;
  margin-bottom: 28rpx;
}

.mode-item {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #58606d;
  font-size: 30rpx;
  font-weight: 600;
}

.mode-item.active {
  background: #0eb85d;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(14, 184, 93, 0.2);
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.input,
.picker-value {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f8fafb;
  border: 2rpx solid #e6ecf0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: #98a2ad;
  font-size: 28rpx;
}

.input-placeholder {
  color: #98a2ad;
  font-size: 24rpx;
}

.field-rule {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7c8795;
  white-space: normal;
  word-break: break-all;
}

.picker-value.selected {
  color: #1f2430;
}

.radio-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.radio-item {
  min-width: 180rpx;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f8fafb;
  border: 2rpx solid #e6ecf0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  color: #1f2430;
  font-size: 28rpx;
}

.radio-item radio {
  transform: scale(0.9);
  margin-right: 10rpx;
}

.action-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 14rpx;
  font-size: 32rpx;
}
