<view class="page">
  <view class="hero">
    <text class="hero-title">欢迎使用</text>
    <text class="hero-subtitle">大学生兼职小程序</text>
  </view>

  <view class="auth-card">
    <view class="mode-switch">
      <view class="mode-item {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode">
        <text>登录</text>
      </view>
      <view class="mode-item {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode">
        <text>注册</text>
      </view>
    </view>

    <block wx:if="{{mode === 'login'}}">
      <view class="form-item">
        <text class="label">账号</text>
        <input
          class="input"
          maxlength="{{userNameMaxLength}}"
          placeholder-class="input-placeholder"
          placeholder="{{userNamePlaceholder}}"
          value="{{loginForm.userName}}"
          data-field="userName"
          bindinput="onLoginFieldChange"
        />
        <text class="field-rule">{{userNameRuleHint}}</text>
      </view>
      <view class="form-item">
        <text class="label">密码</text>
        <input
          class="input"
          password
          maxlength="{{passwordMaxLength}}"
          placeholder-class="input-placeholder"
          placeholder="{{passwordPlaceholder}}"
          value="{{loginForm.password}}"
          data-field="password"
          bindinput="onLoginFieldChange"
        />
        <text class="field-rule">{{passwordRuleHint}}</text>
      </view>
      <view class="form-item">
        <text class="label">登录身份</text>
        <radio-group class="radio-row" bindchange="onLoginRoleChange">
          <label class="radio-item">
            <radio value="3" checked="{{loginForm.roleId === 3}}" />
            <text>普通用户</text>
          </label>
          <label class="radio-item">
            <radio value="2" checked="{{loginForm.roleId === 2}}" />
            <text>企业用户</text>
          </label>
        </radio-group>
      </view>
      <button class="btn-primary action-btn" bindtap="onLogin" loading="{{loading}}">登录</button>
    </block>

    <block wx:else>
      <view class="form-item">
        <text class="label">注册身份</text>
        <radio-group class="radio-row" bindchange="onRegisterRoleChange">
          <label class="radio-item">
            <radio value="3" checked="{{registerForm.roleId === 3}}" />
            <text>普通用户</text>
          </label>
          <label class="radio-item">
            <radio value="2" checked="{{registerForm.roleId === 2}}" />
            <text>企业用户</text>
          </label>
        </radio-group>
      </view>
      <view class="form-item">
        <text class="label">账号</text>
        <input
          class="input"
          maxlength="{{userNameMaxLength}}"
          placeholder-class="input-placeholder"
          placeholder="{{userNamePlaceholder}}"
          value="{{registerForm.userName}}"
          data-field="userName"
          bindinput="onRegisterFieldChange"
        />
        <text class="field-rule">{{userNameRuleHint}}</text>
      </view>
      <view class="form-item">
        <text class="label">密码</text>
        <input
          class="input"
          password
          maxlength="{{passwordMaxLength}}"
          placeholder-class="input-placeholder"
          placeholder="{{passwordPlaceholder}}"
          value="{{registerForm.password}}"
          data-field="password"
          bindinput="onRegisterFieldChange"
        />
        <text class="field-rule">{{passwordRuleHint}}</text>
      </view>
      <view class="form-item">
        <text class="label">确认密码</text>
        <input
          class="input"
          password
          maxlength="{{passwordMaxLength}}"
          placeholder-class="input-placeholder"
          placeholder="{{passwordPlaceholder}}"
          value="{{registerForm.confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onRegisterFieldChange"
        />
        <text class="field-rule">{{passwordRuleHint}}</text>
      </view>
      <view class="form-item">
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          placeholder="请输入手机号"
          value="{{registerForm.phoneNumber}}"
          data-field="phoneNumber"
          bindinput="onRegisterFieldChange"
        />
      </view>
      <view class="form-item">
        <text class="label">邮箱</text>
        <input
          class="input"
          placeholder="请输入邮箱，可选"
          value="{{registerForm.email}}"
          data-field="email"
          bindinput="onRegisterFieldChange"
        />
      </view>
      <view class="form-item">
        <text class="label">性别</text>
        <radio-group class="radio-row" bindchange="onGenderChange">
          <label class="radio-item">
            <radio value="male" checked="{{registerForm.sex === true}}" />
            <text>男</text>
          </label>
          <label class="radio-item">
            <radio value="female" checked="{{registerForm.sex === false}}" />
            <text>女</text>
          </label>
        </radio-group>
      </view>
      <view wx:if="{{registerForm.roleId === 2}}" class="form-item">
        <text class="label">所属企业</text>
        <picker class="picker-wrap" mode="selector" range="{{companyList}}" range-key="name" value="{{companyIndex}}" bindchange="onCompanyChange">
          <view class="picker-value {{companyIndex >= 0 ? 'selected' : ''}}">
            {{companyIndex >= 0 ? companyList[companyIndex].name : (companyList.length ? '请选择所属企业' : '暂无可选企业')}}
          </view>
        </picker>
      </view>
      <button class="btn-primary action-btn" bindtap="onRegister" loading="{{loading}}">注册</button>
    </block>
  </view>
</view>
