.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f8fa;
  box-sizing: border-box;
}

.page-head {
  margin-bottom: 20rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2430;
}

.page-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.loading-card,
.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 36, 48, 0.06);
}

.loading-card {
  padding: 60rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8f99;
}

.form-card {
  padding: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.input,
.textarea {
  width: 100%;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f8fafb;
  border: 2rpx solid #e6ecf0;
  font-size: 28rpx;
  color: #1f2430;
  box-sizing: border-box;
}

.input {
  height: 88rpx;
}

.textarea {
  min-height: 220rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.gender-row {
  display: flex;
  gap: 16rpx;
}

.gender-pill {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  border: 2rpx solid #e6ecf0;
  background: #f8fafb;
  font-size: 28rpx;
  color: #58606d;
}

.gender-pill.active {
  border-color: #07c160;
  background: #effbf3;
  color: #07c160;
  font-weight: 600;
}

.save-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 16rpx;
}
