<view class="page">
  <view class="page-head">
    <view class="back-btn" bindtap="goBack">
      <van-icon name="arrow-left" size="36rpx" color="#ffffff"></van-icon>
    </view>
    <text class="page-title">个人信息</text>
    <view class="save-btn" bindtap="savePersonalInfo">保存</view>
  </view>

  <view class="form-card">
    <view class="avatar-block">
      <image class="avatar" src="{{avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
      <button class="btn-primary avatar-btn" bindtap="chooseImage">更换头像</button>
    </view>

    <view class="form-item">
      <text class="label">账号</text>
      <input
        class="input"
        value="{{userInfo.userName}}"
        data-name="userName"
        bindinput="onFieldChange"
        maxlength="{{userNameMaxLength}}"
        placeholder-class="input-placeholder"
        placeholder="{{userNamePlaceholder}}"
      />
      <text class="field-rule">{{userNameRuleHint}}</text>
    </view>

    <view class="form-item">
      <text class="label">性别</text>
      <radio-group class="gender-row" bindchange="onGenderChange">
        <label class="gender-item">
          <radio value="male" checked="{{userInfo.sex === true}}" />
          <text>男</text>
        </label>
        <label class="gender-item">
          <radio value="female" checked="{{userInfo.sex === false}}" />
          <text>女</text>
        </label>
        <label class="gender-item">
          <radio value="secret" checked="{{userInfo.sex === null || userInfo.sex === undefined}}" />
          <text>保密</text>
        </label>
      </radio-group>
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" value="{{userInfo.phoneNumber}}" data-name="phoneNumber" bindinput="onFieldChange" type="number" placeholder="请输入手机号" />
    </view>

    <view class="form-item">
      <text class="label">邮箱</text>
      <input class="input" value="{{userInfo.email}}" data-name="email" bindinput="onFieldChange" placeholder="请输入邮箱" />
    </view>

    <view class="form-item">
      <text class="label">当前身份</text>
      <view class="readonly">
        <text class="role-chip">{{roleId === 2 ? '企业用户' : '普通用户'}}</text>
      </view>
    </view>
  </view>
</view>
