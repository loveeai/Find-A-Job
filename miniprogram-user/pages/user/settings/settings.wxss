.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  width: 100%;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx 40rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #f5f5f5;
}

.settings-menu {
  margin: 30rpx 0;
}

.menu-group {
  background-color: #fff;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 28rpx;
  color: #999;
  padding: 30rpx 40rpx 10rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item image {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.menu-item text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: auto;
  color: #999;
}

.menu-item:active {
  background-color: #f5f5f5;
}