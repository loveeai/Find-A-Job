.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  width: 100%;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx 40rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #f5f5f5;
}

.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background-color: #fff;
  margin: 30rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.app-logo image {
  width: 100%;
  height: 100%;
}

.app-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.app-version {
  font-size: 28rpx;
  color: #999;
}

.about-menu {
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item text {
  font-size: 30rpx;
  color: #333;
}

.menu-item image {
  width: 24rpx;
  height: 24rpx;
  color: #999;
}

.menu-item:active {
  background-color: #f5f5f5;
}

.copyright {
  margin-top: auto;
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  background-color: #fff;
  border-top: 2rpx solid #f5f5f5;
}