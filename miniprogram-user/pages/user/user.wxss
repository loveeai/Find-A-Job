.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: linear-gradient(180deg, #0eb85d 0%, #0eb85d 280rpx, #f6f8fa 280rpx, #f6f8fa 100%);
  box-sizing: border-box;
}

.hero-card,
.menu-card {
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 14rpx 30rpx rgba(31, 36, 48, 0.06);
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0eb85d 0%, #14a06a 100%);
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 6rpx solid rgba(255, 255, 255, 0.26);
  flex-shrink: 0;
}

.hero-body {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.user-role {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
}

.hero-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.menu-card {
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
}

.secondary-card {
  margin-top: 18rpx;
}

.section-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2430;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f3f5f7;
}

.menu-item:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.menu-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #1f2430;
}

.logout-wrap {
  margin-top: 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
}
