.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  width: 100%;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx 40rpx;
  background-color: #fff;
  border-bottom: 2rpx solid #f5f5f5;
}

.feedback-content,
.contact-info,
.image-upload {
  background-color: #fff;
  margin: 30rpx 0;
  padding: 30rpx 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #f5f5f5;
  border-radius: 10rpx;
  resize: none;
}

.word-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #f5f5f5;
  border-radius: 10rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 10rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border: 2rpx dashed #ccc;
}

.add-btn image {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.add-btn text {
  font-size: 24rpx;
  color: #999;
}

.submit-btn {
  width: 80%;
  margin: 60rpx auto;
  font-size: 32rpx;
  box-sizing: border-box;
  display: block;
}

.submit-btn[disabled] {
  opacity: 0.6;
}