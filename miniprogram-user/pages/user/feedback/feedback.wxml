<view class="container">
  <view class="page-title">意见反馈</view>
  
  <!-- 反馈内容 -->
  <view class="feedback-content">
    <text class="section-title">反馈内容</text>
    <textarea 
      placeholder="请输入您的反馈意见..." 
      value="{{feedbackContent}}"
      bindinput="onContentInput"
      maxlength="500"
    ></textarea>
    <text class="word-count">{{feedbackContent.length}}/500</text>
  </view>
  
  <!-- 联系方式 -->
  <view class="contact-info">
    <text class="section-title">联系方式 (选填)</text>
    <input 
      placeholder="请输入您的邮箱或手机号" 
      value="{{contactInfo}}"
      bindinput="onContactInput"
      maxlength="50"
    ></input>
  </view>
  
  <!-- 图片上传 -->
  <view class="image-upload">
    <text class="section-title">上传图片 (最多3张)</text>
    <view class="image-list">
      <view class="image-item" wx:for="{{imageList}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill"></image>
        <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">
          <text>×</text>
        </view>
      </view>
      <view class="image-item add-btn" bindtap="chooseImage" wx:if="{{imageList.length < 3}}">
        <image src="../../../images/add-image.png" mode="aspectFit"></image>
        <text>添加图片</text>
      </view>
    </view>
  </view>
  
  <!-- 提交按钮 -->
  <button 
    class="btn-primary submit-btn" 
    bindtap="submitFeedback"
    disabled="{{isSubmitting}}"
  >
    {{isSubmitting ? '提交中...' : '提交反馈'}}
  </button>
</view>