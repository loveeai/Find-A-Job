.container {
  padding-top: 10px;
  padding-bottom: 20rpx;
  background-color: #f5f5f5;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  padding: 20rpx 24rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  text-align: left;
  color: #333;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 200rpx;
  text-align: center;
}

.loading image {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}

.loading text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 200rpx;
  text-align: center;
}

.empty text {
  color: #999;
  font-size: 28rpx;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.go-browse-btn {
  background-color: #07c160;
  color: white;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  display: inline-block;
  line-height: 1.5;
}

/* 面试列表 */
.interview-list {
  width: 100%;
  padding: 12rpx 12rpx 12rpx 12rpx;
}

.interview-item {
  background: white;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
  transition: box-shadow 0.3s ease;
}

.interview-item:active {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 头部：职位标题和菜单 */
.interview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  background: linear-gradient(135deg, #fff 0%, #fafafa 100%);
}

.job-title-section {
  flex: 1;
  display: flex;
  align-items: center;
}

.job-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.3;
}

.action-menu {
  padding: 0 8rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
}

/* 企业信息区 */
.company-section {
  padding: 12rpx 20rpx 12rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.company-header {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.company-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 4rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.company-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.company-name {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  line-height: 1.2;
}

/* 职位详情 */
.job-details {
  padding: 14rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  align-items: center;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #999;
  min-width: 60rpx;
  font-weight: 500;
  font-size: 26rpx;
}

.detail-value {
  color: #333;
  flex: 1;
  font-size: 26rpx;
}

/* 面试信息 */
.interview-info {
  padding: 14rpx 20rpx;
  background-color: #f0f8ff;
  border-bottom: 1rpx solid #f0f0f0;
}

.interview-detail {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  gap: 8rpx;
}

.interview-detail:last-child {
  margin-bottom: 0;
}

.detail-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.detail-text .label {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
  margin-bottom: 0;
}

.detail-text .value {
  font-size: 26rpx;
  color: #333;
  line-height: 1.2;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fff;
}

.action-buttons button {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
}
